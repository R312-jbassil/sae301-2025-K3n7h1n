---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ma galerie - TaVue">
	<div class="min-h-screen bg-base-200 py-12">
		<div class="container mx-auto px-4 max-w-7xl">
			<!-- Header -->
			<div class="text-center mb-12">
				<h1 class="text-4xl font-bold mb-4">Ma galerie</h1>
				<p class="text-lg text-base-content/70">
					Retrouvez toutes vos créations de lunettes personnalisées et vos SVG générés par IA
				</p>
			</div>

			<!-- Tabs Navigation -->
			<div role="tablist" class="tabs tabs-boxed mb-8 bg-base-100 shadow-lg">
				<a role="tab" class="tab tab-active" id="tab-lunettes">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
					</svg>
					Mes Lunettes
				</a>
				<a role="tab" class="tab" id="tab-svg">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
					</svg>
					Créations IA
				</a>
			</div>
			
			<!-- Sidebar + Grid Layout -->
			<div class="flex flex-col lg:flex-row gap-8" id="content-lunettes">
				<!-- Sidebar - Mes créations count -->
				<div class="lg:w-64 shrink-0">
					<div class="card bg-base-100 shadow-xl sticky top-24">
						<div class="card-body">
							<h2 class="card-title text-lg">Mes créations</h2>
							<div class="text-4xl font-bold text-primary" id="creations-count">0</div>
							<div class="divider"></div>
							<a href="/configurateur" class="btn btn-primary btn-block">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
								</svg>
								Nouvelle création
							</a>
						</div>
					</div>
				</div>
				
				<!-- Grid des créations -->
				<div class="grow">
					<!-- Loading state -->
					<div id="loading-state" class="flex justify-center items-center py-20">
						<span class="loading loading-spinner loading-lg text-primary"></span>
					</div>
					
					<!-- Empty state -->
					<div id="empty-state" class="hidden">
						<div class="card bg-base-100 shadow-xl">
							<div class="card-body text-center py-20">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-base-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
								<h2 class="text-2xl font-bold mb-2">Aucune création pour le moment</h2>
								<p class="text-base-content/70 mb-6">Commencez à créer vos lunettes personnalisées !</p>
								<a href="/configurateur" class="btn btn-primary">Créer mes lunettes</a>
							</div>
						</div>
					</div>
					
					<!-- Grid des lunettes -->
					<div id="lunettes-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
						<!-- Les cartes seront ajoutées dynamiquement ici -->
					</div>
				</div>
			</div>

			<!-- Content for SVG IA Section -->
			<div class="hidden" id="content-svg">
				<div class="flex flex-col lg:flex-row gap-8">
					<!-- Sidebar - SVG count -->
					<div class="lg:w-64 shrink-0">
						<div class="card bg-base-100 shadow-xl sticky top-24">
							<div class="card-body">
								<h2 class="card-title text-lg">Mes SVG IA</h2>
								<div class="text-4xl font-bold text-secondary" id="svg-count">0</div>
								<div class="divider"></div>
								<a href="/generateurIA" class="btn btn-secondary btn-block">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
									</svg>
									Nouveau SVG
								</a>
								<a href="/gallery" class="btn btn-ghost btn-block btn-sm">
									Voir tous les SVG
								</a>
							</div>
						</div>
					</div>
					
					<!-- Grid SVG -->
					<div class="grow">
						<!-- Loading state SVG -->
						<div id="loading-state-svg" class="flex justify-center items-center py-20">
							<span class="loading loading-spinner loading-lg text-secondary"></span>
						</div>
						
						<!-- Empty state SVG -->
						<div id="empty-state-svg" class="hidden">
							<div class="card bg-base-100 shadow-xl">
								<div class="card-body text-center py-20">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-base-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
									</svg>
									<h2 class="text-2xl font-bold mb-2">Aucun SVG généré</h2>
									<p class="text-base-content/70 mb-6">Commencez à créer des SVG avec l'IA !</p>
									<a href="/generateurIA" class="btn btn-secondary">Générer un SVG</a>
								</div>
							</div>
						</div>
						
						<!-- Grid des SVG -->
						<div id="svg-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
							<!-- Les cartes SVG seront ajoutées dynamiquement ici -->
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal de confirmation de suppression -->
	<dialog id="delete-modal" class="modal">
		<div class="modal-box">
			<h3 class="font-bold text-lg mb-4">Confirmer la suppression</h3>
			<p class="py-4">Êtes-vous sûr de vouloir supprimer cette création ? Cette action est irréversible.</p>
			<div class="modal-action">
				<button id="cancel-delete-btn" class="btn btn-ghost">Annuler</button>
				<button id="confirm-delete-btn" class="btn btn-error">Supprimer</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>

	<script>
		import { getUserLunettes, deleteLunette, isAuthenticated, addToCart } from '../JS/pocketbase.js';
		import PocketBase from 'pocketbase';

		const pb = new PocketBase('http://127.0.0.1:8090');

		let lunettes: any[] = [];
		let svgList: any[] = [];
		let lunetteToDelete: string | null = null;
		let currentTab: 'lunettes' | 'svg' = 'lunettes';

		// Vérifier l'authentification
		if (!isAuthenticated()) {
			alert('Vous devez être connecté pour voir vos créations');
			window.location.href = '/connexion';
		}

		// Load auth
		const authCookie = document.cookie
			.split('; ')
			.find(row => row.startsWith('pb_auth='));
		if (authCookie) {
			pb.authStore.loadFromCookie(authCookie);
		}

		// Gestion des onglets
		const tabLunettes = document.getElementById('tab-lunettes');
		const tabSvg = document.getElementById('tab-svg');
		const contentLunettes = document.getElementById('content-lunettes');
		const contentSvg = document.getElementById('content-svg');

		tabLunettes?.addEventListener('click', () => {
			currentTab = 'lunettes';
			tabLunettes.classList.add('tab-active');
			tabSvg?.classList.remove('tab-active');
			contentLunettes?.classList.remove('hidden');
			contentSvg?.classList.add('hidden');
		});

		tabSvg?.addEventListener('click', () => {
			currentTab = 'svg';
			tabSvg.classList.add('tab-active');
			tabLunettes?.classList.remove('tab-active');
			contentSvg?.classList.remove('hidden');
			contentLunettes?.classList.add('hidden');
			if (svgList.length === 0) {
				loadSVGCreations();
			}
		});

		// Charger les créations
		async function loadCreations() {
			const loadingState = document.getElementById('loading-state');
			const emptyState = document.getElementById('empty-state');
			const grid = document.getElementById('lunettes-grid');
			const countEl = document.getElementById('creations-count');

			try {
				lunettes = await getUserLunettes();
				console.log('👓 Créations chargées:', lunettes);

				if (loadingState) loadingState.classList.add('hidden');

				if (lunettes.length === 0) {
					if (emptyState) emptyState.classList.remove('hidden');
					if (countEl) countEl.textContent = '0';
				} else {
					if (grid) {
						grid.classList.remove('hidden');
						displayLunettes();
					}
					if (countEl) countEl.textContent = lunettes.length.toString();
				}
			} catch (error) {
				console.error('❌ Erreur de chargement:', error);
				if (loadingState) loadingState.classList.add('hidden');
				alert('Erreur lors du chargement de vos créations');
			}
		}

		// Afficher les lunettes
		function displayLunettes() {
			const grid = document.getElementById('lunettes-grid');
			if (!grid) return;

			grid.innerHTML = '';

			lunettes.forEach((lunette) => {
				const card = document.createElement('div');
				card.className = 'card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow';
				
				// Formater la date
				const createdDate = new Date(lunette.created);
				const dateStr = `Créée le ${createdDate.toLocaleDateString('fr-FR')}`;
				
				// Couleurs par défaut si non définies
				const couleurMonture = lunette.couleur_monture_hex || '#1d1d1b';
				const couleurBranches = lunette.couleur_branche_hex || '#8B4513';
				const couleurVerres = lunette.couleur_verre_hex || 'rgba(135, 206, 235, 0.5)';

				card.innerHTML = `
					<figure class="px-10 pt-10 pb-6">
						<div class="w-full h-48 bg-white rounded-lg flex items-center justify-center p-4">
							<svg 
								xmlns="http://www.w3.org/2000/svg" 
								xmlns:xlink="http://www.w3.org/1999/xlink" 
								version="1.1" 
								viewBox="50 120 495 140"
								style="filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2)); width: 100%; height: auto;"
							>
								<defs>
									<style>
										.cls-1-${lunette.id} {
											fill: ${couleurBranches};
										}
										.cls-2-${lunette.id} {
											isolation: isolate;
										}
										.cls-3-${lunette.id} {
											fill: ${couleurMonture};
										}
										.cls-4-${lunette.id} {
											fill: ${couleurBranches};
											stroke: ${couleurMonture};
											stroke-miterlimit: 10;
											stroke-width: 1px;
										}
										.cls-5-${lunette.id} {
											fill: ${couleurVerres};
											opacity: .75;
										}
										/* Spécifique pour la monture */
										#monture .cls-4-${lunette.id} {
											fill: ${couleurMonture};
										}
									</style>
								</defs>
								<g class="cls-2-${lunette.id}">
									<g id="branches">
										<path class="cls-4-${lunette.id}" d="M108.83,155.14s49.35-5.57,54.93-8.76,11.14-7.96,19.5-9.55,64.48-11.14,64.48-11.14c0,0,7.16-1.99,17.51,5.57s33.04,31.84,39.4,31.05c6.37-.8,9.55-9.55,7.56-13.53s-40.67-32.75-47.36-34.63c-9.53-2.68-21.89-2.39-37.02,0-15.12,2.39-116.22,23.34-116.22,23.34,0,0-13.13,6.12-2.79,17.66Z"/>
										<path class="cls-1-${lunette.id}" d="M308.24,150.76s-.31,6.15-3.98,5.57c-4.97-.78-35.82-33.83-46.17-32.24,0,0,8.53,2.71,18.46,11.64,6.51,5.86,34.42,37.85,31.69,15.03Z"/>
										<path class="cls-4-${lunette.id}" d="M374.79,179.65l90.54-29.78s22.13-5.63,25.35-4.02,17.71,30.58,17.71,33.8-2.42,14.01-5.63,14.89c-2.33.64-5.33.11-6.84-4.21-1.41-4.02-6.84-31.73-12.47-31.47s-50.7,15.95-50.7,15.95c0,0-13.28,6.44-18.91,11.27s-32.19,11.27-32.19,11.27c0,0-9.66-7.65-6.84-17.71Z"/>
										<path class="cls-1-${lunette.id}" d="M381.34,180.1s102.27-35.19,107.85-31.99c0,0-18.2,2.49-41.76,11.88s-66.09,22.03-66.09,22.03v-1.92Z"/>
										<path class="cls-1-${lunette.id}" d="M485.36,158.06s3.26,0,4.98,3.45,9.77,24.71,9.77,24.71c0,0,.77,4.98,5.17-2.68,0,0-3.07,9.56-5.36,6.79s-9.77-26.33-9.77-26.33c0,0-2.87-6.74-4.79-5.94Z"/>
									</g>
									<g id="monture">
										<path class="cls-4-${lunette.id}" d="M385.31,180.81c-.24-3.41-9.57-5.22-12.71-6.4-3.14-1.18-15.7,1.96-15.7,1.96-12.17-3.14-54.55-9.03-78.88-9.03s-32.57,11.38-35.32,10.99c-2.75-.39-17.27-.78-23.55-1.96-6.28-1.18-5.1-14.13-39.25-26.48-34.14-12.35-68.29-12.42-68.29-12.42-13.35,4.66-6.76,18.49-6.76,18.49l2.05,6.35c4.32,2.03,3.14,10.52,4.71,23.08s7.46,28.65,14.13,38.46c6.67,9.81,31.79,20.8,44.35,21.19s23.55-1.96,31.79-15.31c8.24-13.34,16.88-36.89,16.88-36.89l10.2,1.57s2.91.31,5.35,3.09,4.43,8.03,7.6,17.31c7.56,22.1,25.12,39.25,25.12,39.25,0,0,5.6,7.43,33.44,12.66,23.08,4.34,42.7-2.46,42.7-2.46,17.72-7.17,21.63-44.96,21.63-44.96,0,0,1.83-13.3,7.81-16.65,7.37-4.14,8.27-4.44,12.71-5.32,3.61-.71.24-13.13,0-16.54ZM190.5,231.32c-9.42,5.1-32.18,7.06-46.31-3.92-14.13-10.99-20.8-30.22-22.76-52.98s7.1-25.23,7.1-25.23c0,0,14.88-.67,34.11,4.03,19.23,4.71,40.42,18.05,40.82,26.69.39,8.63-3.53,46.31-12.95,51.41ZM344.73,255.65c-9.03,4.32-21.47,4.71-31.93,3.92-10.46-.78-37.54-1.57-47.35-31.4,0,0-2.75-14.13-5.1-17.27-2.35-3.14-9.42-14.48-9.42-18.43,0-8.23,7.15-12.97,7.15-12.97,0,0,8.16-5.1,18.75-5.1,10.6,0,64.75,2.75,72.21,12.95,7.46,10.2,7.06,21.98,8.24,31.4,1.18,9.42-3.53,32.57-12.56,36.89Z"/>
									</g>
									<g id="verres">
										<path class="cls-5-${lunette.id}" d="M116.32,162.87c-.88,6.05.4,37.41,11.44,55.31s37.04,21.35,41.37,21.31,18.51,1.02,24.47-9.27c4.97-8.59,13.17-43.48,9.12-53.05-6.26-14.82-40.4-24.02-40.4-24.02,0,0-26.85-5.46-33.82-4.46,0,0-9.97-.96-12.17,14.17Z"/>
										<path class="cls-5-${lunette.id}" d="M247.32,192.54s-1.09-9.55,19.57-16.69c11.76-4.06,60.46,3.23,60.46,3.23,0,0,19.09,4.06,21.71,8.28,2.62,4.22,9.46,17.24,8.29,37.97-1.14,20.21-7.31,26.8-12.61,30.31,0,0-7.1,4.93-21.34,5.93-26.65,1.88-37.01-1.14-46.19-7.73-29.88-21.46-29.88-61.3-29.88-61.3Z"/>
									</g>
								</g>
							</svg>
						</div>
					</figure>
					<div class="card-body pt-0">
						<h2 class="card-title text-xl">${lunette.nom_modele || 'Sans nom'}</h2>
						<p class="text-sm text-base-content/70">${dateStr}</p>
						
						<!-- Couleurs -->
						<div class="flex gap-2 my-2">
							${lunette.couleur_monture_hex ? `
								<div class="tooltip" data-tip="Couleur monture">
									<div class="w-6 h-6 rounded-full border-2 border-base-300" style="background-color: ${lunette.couleur_monture_hex}"></div>
								</div>
							` : ''}
							${lunette.couleur_branche_hex ? `
								<div class="tooltip" data-tip="Couleur branches">
									<div class="w-6 h-6 rounded-full border-2 border-base-300" style="background-color: ${lunette.couleur_branche_hex}"></div>
								</div>
							` : ''}
							${lunette.couleur_verre_hex ? `
								<div class="tooltip" data-tip="Couleur verres">
									<div class="w-6 h-6 rounded-full border-2 border-base-300" style="background-color: ${lunette.couleur_verre_hex}"></div>
								</div>
							` : ''}
						</div>
						
						<div class="card-actions justify-between items-center mt-4">
							<div class="flex gap-2">
								<a 
									href="/lunette/${lunette.id}"
									class="btn btn-sm btn-ghost btn-circle"
									title="En savoir plus"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
									</svg>
								</a>
								<button 
									class="btn btn-sm btn-ghost btn-circle"
									onclick="addToCartFromGallery('${lunette.id}')"
									title="Ajouter au panier"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
									</svg>
								</button>
								<button 
									class="btn btn-sm btn-ghost btn-circle text-error"
									onclick="confirmDelete('${lunette.id}')"
									title="Supprimer"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
									</svg>
								</button>
							</div>
							<a 
								href="/lunette/${lunette.id}"
								class="btn btn-primary btn-sm"
							>
								Voir les détails
							</a>
						</div>
					</div>
				`;

				grid.appendChild(card);
			});
		}

		// Charger les SVG créés par l'IA
		async function loadSVGCreations() {
			const loadingState = document.getElementById('loading-state-svg');
			const emptyState = document.getElementById('empty-state-svg');
			const grid = document.getElementById('svg-grid');
			const countEl = document.getElementById('svg-count');

			try {
				const userId = pb.authStore.model?.id;
				if (!userId) {
					throw new Error('User not authenticated');
				}

				// Charger tous les SVG (pour l'instant sans filtre utilisateur)
				// TODO: Ajouter un champ 'user' dans la collection lunette_ia pour filtrer par utilisateur
				svgList = await pb.collection('lunette_ia').getFullList({
					sort: '-created',
				});
				
				console.log('🎨 SVG chargés:', svgList);

				if (loadingState) loadingState.classList.add('hidden');

				if (svgList.length === 0) {
					if (emptyState) emptyState.classList.remove('hidden');
					if (grid) grid.classList.add('hidden');
					if (countEl) countEl.textContent = '0';
				} else {
					if (emptyState) emptyState.classList.add('hidden');
					if (grid) {
						grid.classList.remove('hidden');
						displaySVG();
					}
					if (countEl) countEl.textContent = svgList.length.toString();
				}
			} catch (error) {
				console.error('❌ Erreur de chargement SVG:', error);
				if (loadingState) loadingState.classList.add('hidden');
				if (emptyState) emptyState.classList.remove('hidden');
			}
		}

		// Afficher les SVG
		function displaySVG() {
			const grid = document.getElementById('svg-grid');
			if (!grid) return;

			grid.innerHTML = '';

			svgList.forEach((svg) => {
				const card = document.createElement('div');
				card.className = 'card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow';
				
				const createdDate = new Date(svg.created);
				const dateStr = `Créé le ${createdDate.toLocaleDateString('fr-FR')}`;

				card.innerHTML = `
					<figure class="px-10 pt-10 bg-white min-h-[250px] flex items-center justify-center">
						<div class="w-full h-full flex items-center justify-center">
							${svg.code_svg || '<p class="text-gray-400">Aperçu non disponible</p>'}
						</div>
					</figure>
					<div class="card-body">
						<h2 class="card-title">${svg.modele_ia || 'Sans nom'}</h2>
						<p class="text-sm text-base-content/70">${dateStr}</p>
						
						<div class="card-actions justify-between items-center mt-4">
							<div class="flex gap-2">
								<a 
									href="/gallery/${svg.id}"
									class="btn btn-sm btn-ghost btn-circle"
									title="Modifier"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
									</svg>
								</a>
								<button 
									class="btn btn-sm btn-ghost btn-circle"
									onclick="copySVGCode('${svg.id}')"
									title="Copier le code"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
									</svg>
								</button>
								<button 
									class="btn btn-sm btn-ghost btn-circle text-error"
									onclick="confirmDeleteSVG('${svg.id}')"
									title="Supprimer"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
									</svg>
								</button>
							</div>
							<a 
								href="/gallery/${svg.id}"
								class="btn btn-secondary btn-sm"
							>
								Modifier
							</a>
						</div>
					</div>
				`;

				grid.appendChild(card);
			});
		}

		// Copier le code SVG
		(window as any).copySVGCode = function(svgId: string) {
			const svg = svgList.find(s => s.id === svgId);
			if (svg && svg.code_svg) {
				navigator.clipboard.writeText(svg.code_svg).then(() => {
					alert('✅ Code SVG copié dans le presse-papier !');
				}).catch(err => {
					console.error('Erreur de copie:', err);
					alert('❌ Erreur lors de la copie');
				});
			}
		};

		// Confirmer suppression SVG
		(window as any).confirmDeleteSVG = async function(svgId: string) {
			if (confirm('Êtes-vous sûr de vouloir supprimer ce SVG ?')) {
				try {
					await pb.collection('lunette_ia').delete(svgId);
					alert('✅ SVG supprimé avec succès');
					await loadSVGCreations();
				} catch (error) {
					console.error('❌ Erreur de suppression:', error);
					alert('❌ Erreur lors de la suppression');
				}
			}
		};

		// Confirmer la suppression
		(window as any).confirmDelete = function(lunetteId: string) {
			lunetteToDelete = lunetteId;
			const modal = document.getElementById('delete-modal') as HTMLDialogElement;
			if (modal) modal.showModal();
		};

		// Ajouter au panier depuis la galerie
		(window as any).addToCartFromGallery = async function(lunetteId: string) {
			try {
				await addToCart(lunetteId);
				alert('✅ Lunettes ajoutées au panier !');
				window.location.href = '/panier';
			} catch (error) {
				console.error('❌ Erreur d\'ajout au panier:', error);
				alert('❌ Erreur lors de l\'ajout au panier');
			}
		};

		// Annuler la suppression
		document.getElementById('cancel-delete-btn')?.addEventListener('click', () => {
			lunetteToDelete = null;
			const modal = document.getElementById('delete-modal') as HTMLDialogElement;
			if (modal) modal.close();
		});

		// Confirmer et supprimer
		document.getElementById('confirm-delete-btn')?.addEventListener('click', async () => {
			if (!lunetteToDelete) return;

			try {
				await deleteLunette(lunetteToDelete);
				
				const modal = document.getElementById('delete-modal') as HTMLDialogElement;
				if (modal) modal.close();
				
				// Recharger les créations
				lunetteToDelete = null;
				await loadCreations();
				
				alert('✅ Création supprimée avec succès');
			} catch (error) {
				console.error('❌ Erreur de suppression:', error);
				alert('❌ Erreur lors de la suppression');
			}
		});

		// Charger les créations au chargement de la page
		loadCreations();
	</script>
</Layout>
