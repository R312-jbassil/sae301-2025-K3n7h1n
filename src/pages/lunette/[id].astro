---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Détails lunettes - TaVue">
	<div class="min-h-screen bg-base-200 py-12">
		<div class="container mx-auto px-4 max-w-6xl">
			<!-- Loader -->
			<div id="loader" class="flex justify-center items-center py-20">
				<span class="loading loading-spinner loading-lg text-primary"></span>
			</div>

			<!-- Contenu -->
			<div id="content" class="hidden">
				<!-- Breadcrumb -->
				<div class="text-sm breadcrumbs mb-6">
					<ul>
						<li><a href="/">Accueil</a></li>
						<li><a href="/ma-galerie">Ma galerie</a></li>
						<li id="breadcrumb-name">Détails</li>
					</ul>
				</div>

				<!-- Bouton retour -->
				<a href="/ma-galerie" class="btn btn-ghost btn-sm mb-6">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
					</svg>
					Retour à ma galerie
				</a>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
					<!-- Colonne gauche : Image -->
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<div class="w-full h-96 bg-white rounded-lg flex items-center justify-center p-8">
								<div id="svg-container" class="w-full h-full flex items-center justify-center">
									<!-- SVG sera inséré ici -->
								</div>
							</div>
						</div>
					</div>

					<!-- Colonne droite : Informations -->
					<div class="space-y-6">
						<!-- Carte principale -->
						<div class="card bg-base-100 shadow-xl">
							<div class="card-body">
								<h1 id="lunette-name" class="card-title text-3xl mb-4">Chargement...</h1>
								
								<div class="divider"></div>

								<!-- Prix -->
								<div class="flex justify-between items-center mb-4">
									<span class="text-lg font-semibold">Prix</span>
									<span id="lunette-prix" class="text-2xl font-bold text-primary">--€</span>
								</div>

								<!-- Date de création -->
								<div class="flex justify-between items-center mb-4">
									<span class="text-base-content/70">Créée le</span>
									<span id="lunette-date" class="font-medium">--</span>
								</div>

								<!-- Taille -->
								<div class="flex justify-between items-center mb-4">
									<span class="text-base-content/70">Taille</span>
									<span id="lunette-taille" class="font-medium">--</span>
								</div>

								<div class="divider"></div>

								<!-- Dimensions -->
								<div class="mb-6">
									<h3 class="font-semibold text-lg mb-3">Dimensions</h3>
									<div class="grid grid-cols-2 gap-3">
										<div class="flex flex-col p-3 bg-base-200 rounded-lg">
											<span class="text-xs text-base-content/70">Largeur pont</span>
											<span id="dim-pont" class="font-semibold text-lg">-- mm</span>
										</div>
										<div class="flex flex-col p-3 bg-base-200 rounded-lg">
											<span class="text-xs text-base-content/70">Largeur verre</span>
											<span id="dim-verre-largeur" class="font-semibold text-lg">-- mm</span>
										</div>
										<div class="flex flex-col p-3 bg-base-200 rounded-lg">
											<span class="text-xs text-base-content/70">Hauteur verre</span>
											<span id="dim-verre-hauteur" class="font-semibold text-lg">-- mm</span>
										</div>
										<div class="flex flex-col p-3 bg-base-200 rounded-lg">
											<span class="text-xs text-base-content/70">Longueur branche</span>
											<span id="dim-branche" class="font-semibold text-lg">-- mm</span>
										</div>
									</div>
								</div>

								<div class="divider"></div>

								<!-- Couleurs -->
								<div class="mb-6">
									<h3 class="font-semibold text-lg mb-3">Couleurs personnalisées</h3>
									<div class="space-y-3">
										<div class="flex items-center justify-between">
											<span class="text-base-content/70">Monture</span>
											<div class="flex items-center gap-2">
												<div id="color-monture" class="w-8 h-8 rounded-full border-2 border-base-300"></div>
												<span id="hex-monture" class="text-xs font-mono">--</span>
											</div>
										</div>
										<div class="flex items-center justify-between">
											<span class="text-base-content/70">Branches</span>
											<div class="flex items-center gap-2">
												<div id="color-branches" class="w-8 h-8 rounded-full border-2 border-base-300"></div>
												<span id="hex-branches" class="text-xs font-mono">--</span>
											</div>
										</div>
										<div class="flex items-center justify-between">
											<span class="text-base-content/70">Verres</span>
											<div class="flex items-center gap-2">
												<div id="color-verres" class="w-8 h-8 rounded-full border-2 border-base-300"></div>
												<span id="hex-verres" class="text-xs font-mono">--</span>
											</div>
										</div>
									</div>
								</div>

								<div class="divider"></div>

								<!-- Actions -->
								<div class="card-actions flex-col gap-3">
									<button id="add-to-cart-btn" class="btn btn-primary btn-lg w-full">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
										</svg>
										Ajouter au panier
									</button>
									<button id="delete-btn" class="btn btn-outline btn-error w-full">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
										</svg>
										Supprimer cette création
									</button>
								</div>
							</div>
						</div>

						<!-- Carte matériaux -->
						<div class="card bg-base-100 shadow-xl">
							<div class="card-body">
								<h3 class="card-title text-xl mb-4">Matériaux utilisés</h3>
								<div id="materials-container" class="space-y-3">
									<!-- Les matériaux seront insérés ici -->
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Message d'erreur -->
			<div id="error-message" class="hidden">
				<div class="card bg-error text-error-content shadow-xl max-w-lg mx-auto">
					<div class="card-body text-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<h2 class="text-2xl font-bold mb-2">Lunettes introuvables</h2>
						<p class="mb-4">Cette création n'existe pas ou a été supprimée.</p>
						<a href="/ma-galerie" class="btn btn-ghost">Retour à ma galerie</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal de confirmation de suppression -->
	<dialog id="delete-modal" class="modal">
		<div class="modal-box">
			<h3 class="font-bold text-lg mb-4">Confirmer la suppression</h3>
			<p class="mb-6">Êtes-vous sûr de vouloir supprimer cette création ? Cette action est irréversible.</p>
			<div class="modal-action">
				<form method="dialog" class="flex gap-2">
					<button class="btn">Annuler</button>
					<button id="confirm-delete-btn" class="btn btn-error">Supprimer</button>
				</form>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>

	<script>
		import { getLunetteDetails, addToCart, deleteLunette } from '../../JS/pocketbase';

		const params = new URLSearchParams(window.location.search);
		const lunetteId = window.location.pathname.split('/').pop();

		console.log('🔍 ID lunette:', lunetteId);

		let currentLunette: any = null;

		async function loadLunetteDetails() {
			if (!lunetteId) {
				showError();
				return;
			}

			try {
				const details = await getLunetteDetails(lunetteId);
				console.log('✅ Détails chargés:', details);
				currentLunette = details;

				// Vérifier que c'est bien la lunette de l'utilisateur
				// (à implémenter si besoin de sécurité)

				displayLunetteDetails(details);
				
				document.getElementById('loader')?.classList.add('hidden');
				document.getElementById('content')?.classList.remove('hidden');
			} catch (error) {
				console.error('❌ Erreur chargement:', error);
				showError();
			}
		}

		function displayLunetteDetails(lunette: any) {
			// Nom
			const nameEl = document.getElementById('lunette-name');
			if (nameEl) nameEl.textContent = lunette.nom_modele || 'Sans nom';

			// Breadcrumb
			const breadcrumbEl = document.getElementById('breadcrumb-name');
			if (breadcrumbEl) breadcrumbEl.textContent = lunette.nom_modele || 'Détails';

			// Prix
			const prixEl = document.getElementById('lunette-prix');
			if (prixEl) prixEl.textContent = `${lunette.prix?.toFixed(2) || '449.00'}€`;

			// Date
			const dateEl = document.getElementById('lunette-date');
			if (dateEl && lunette.created) {
				const date = new Date(lunette.created);
				dateEl.textContent = date.toLocaleDateString('fr-FR', { 
					day: 'numeric', 
					month: 'long', 
					year: 'numeric' 
				});
			}

			// Taille
			const tailleEl = document.getElementById('lunette-taille');
			if (tailleEl) {
				tailleEl.textContent = lunette.taille_monture || 'Non spécifiée';
			}

			// Dimensions
			const dimPontEl = document.getElementById('dim-pont');
			if (dimPontEl) {
				dimPontEl.textContent = lunette.largeur_pont_mm ? `${lunette.largeur_pont_mm} mm` : '-- mm';
			}

			const dimVerreLargeurEl = document.getElementById('dim-verre-largeur');
			if (dimVerreLargeurEl) {
				dimVerreLargeurEl.textContent = lunette.largeur_verre_mm ? `${lunette.largeur_verre_mm} mm` : '-- mm';
			}

			const dimVerreHauteurEl = document.getElementById('dim-verre-hauteur');
			if (dimVerreHauteurEl) {
				dimVerreHauteurEl.textContent = lunette.hauteur_verre_mm ? `${lunette.hauteur_verre_mm} mm` : '-- mm';
			}

			const dimBrancheEl = document.getElementById('dim-branche');
			if (dimBrancheEl) {
				dimBrancheEl.textContent = lunette.longueur_branche_mm ? `${lunette.longueur_branche_mm} mm` : '-- mm';
			}

			// Couleurs
			const couleurMonture = lunette.couleur_monture_hex || '#1d1d1b';
			const couleurBranches = lunette.couleur_branche_hex || '#8B4513';
			const couleurVerres = lunette.couleur_verre_hex || 'rgba(135, 206, 235, 0.5)';

			const montureEl = document.getElementById('color-monture');
			if (montureEl) montureEl.style.backgroundColor = couleurMonture;
			const hexMontureEl = document.getElementById('hex-monture');
			if (hexMontureEl) hexMontureEl.textContent = couleurMonture;

			const branchesEl = document.getElementById('color-branches');
			if (branchesEl) branchesEl.style.backgroundColor = couleurBranches;
			const hexBranchesEl = document.getElementById('hex-branches');
			if (hexBranchesEl) hexBranchesEl.textContent = couleurBranches;

			const verresEl = document.getElementById('color-verres');
			if (verresEl) verresEl.style.backgroundColor = couleurVerres;
			const hexVerresEl = document.getElementById('hex-verres');
			if (hexVerresEl) hexVerresEl.textContent = couleurVerres;

			// SVG
			displaySVG(lunette);

			// Matériaux
			displayMaterials(lunette);
		}

		function displaySVG(lunette: any) {
			const container = document.getElementById('svg-container');
			if (!container) return;

			const couleurMonture = lunette.couleur_monture_hex || '#1d1d1b';
			const couleurBranches = lunette.couleur_branche_hex || '#8B4513';
			const couleurVerres = lunette.couleur_verre_hex || 'rgba(135, 206, 235, 0.5)';

			container.innerHTML = `
				<svg 
					xmlns="http://www.w3.org/2000/svg" 
					xmlns:xlink="http://www.w3.org/1999/xlink" 
					version="1.1" 
					viewBox="50 120 495 140"
					style="filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2)); width: 100%; height: 100%; max-height: 100%;"
				>
					<defs>
						<style>
							.cls-1-detail {
								fill: ${couleurBranches};
							}
							.cls-2-detail {
								isolation: isolate;
							}
							.cls-3-detail {
								fill: ${couleurMonture};
							}
							.cls-4-detail {
								fill: ${couleurBranches};
								stroke: ${couleurMonture};
								stroke-miterlimit: 10;
								stroke-width: 1px;
							}
							.cls-5-detail {
								fill: ${couleurVerres};
								opacity: .75;
							}
							#monture .cls-4-detail {
								fill: ${couleurMonture};
							}
						</style>
					</defs>
					<g class="cls-2-detail">
						<g id="branches">
							<path class="cls-4-detail" d="M108.83,155.14s49.35-5.57,54.93-8.76,11.14-7.96,19.5-9.55,64.48-11.14,64.48-11.14c0,0,7.16-1.99,17.51,5.57s33.04,31.84,39.4,31.05c6.37-.8,9.55-9.55,7.56-13.53s-40.67-32.75-47.36-34.63c-9.53-2.68-21.89-2.39-37.02,0-15.12,2.39-116.22,23.34-116.22,23.34,0,0-13.13,6.12-2.79,17.66Z"/>
							<path class="cls-1-detail" d="M308.24,150.76s-.31,6.15-3.98,5.57c-4.97-.78-35.82-33.83-46.17-32.24,0,0,8.53,2.71,18.46,11.64,6.51,5.86,34.42,37.85,31.69,15.03Z"/>
							<path class="cls-4-detail" d="M374.79,179.65l90.54-29.78s22.13-5.63,25.35-4.02,17.71,30.58,17.71,33.8-2.42,14.01-5.63,14.89c-2.33.64-5.33.11-6.84-4.21-1.41-4.02-6.84-31.73-12.47-31.47s-50.7,15.95-50.7,15.95c0,0-13.28,6.44-18.91,11.27s-32.19,11.27-32.19,11.27c0,0-9.66-7.65-6.84-17.71Z"/>
							<path class="cls-1-detail" d="M381.34,180.1s102.27-35.19,107.85-31.99c0,0-18.2,2.49-41.76,11.88s-66.09,22.03-66.09,22.03v-1.92Z"/>
							<path class="cls-1-detail" d="M485.36,158.06s3.26,0,4.98,3.45,9.77,24.71,9.77,24.71c0,0,.77,4.98,5.17-2.68,0,0-3.07,9.56-5.36,6.79s-9.77-26.33-9.77-26.33c0,0-2.87-6.74-4.79-5.94Z"/>
						</g>
						<g id="monture">
							<path class="cls-4-detail" d="M385.31,180.81c-.24-3.41-9.57-5.22-12.71-6.4-3.14-1.18-15.7,1.96-15.7,1.96-12.17-3.14-54.55-9.03-78.88-9.03s-32.57,11.38-35.32,10.99c-2.75-.39-17.27-.78-23.55-1.96-6.28-1.18-5.1-14.13-39.25-26.48-34.14-12.35-68.29-12.42-68.29-12.42-13.35,4.66-6.76,18.49-6.76,18.49l2.05,6.35c4.32,2.03,3.14,10.52,4.71,23.08s7.46,28.65,14.13,38.46c6.67,9.81,31.79,20.8,44.35,21.19s23.55-1.96,31.79-15.31c8.24-13.34,16.88-36.89,16.88-36.89l10.2,1.57s2.91.31,5.35,3.09,4.43,8.03,7.6,17.31c7.56,22.1,25.12,39.25,25.12,39.25,0,0,5.6,7.43,33.44,12.66,23.08,4.34,42.7-2.46,42.7-2.46,17.72-7.17,21.63-44.96,21.63-44.96,0,0,1.83-13.3,7.81-16.65,7.37-4.14,8.27-4.44,12.71-5.32,3.61-.71.24-13.13,0-16.54ZM190.5,231.32c-9.42,5.1-32.18,7.06-46.31-3.92-14.13-10.99-20.8-30.22-22.76-52.98s7.1-25.23,7.1-25.23c0,0,14.88-.67,34.11,4.03,19.23,4.71,40.42,18.05,40.82,26.69.39,8.63-3.53,46.31-12.95,51.41ZM344.73,255.65c-9.03,4.32-21.47,4.71-31.93,3.92-10.46-.78-37.54-1.57-47.35-31.4,0,0-2.75-14.13-5.1-17.27-2.35-3.14-9.42-14.48-9.42-18.43,0-8.23,7.15-12.97,7.15-12.97,0,0,8.16-5.1,18.75-5.1,10.6,0,64.75,2.75,72.21,12.95,7.46,10.2,7.06,21.98,8.24,31.4,1.18,9.42-3.53,32.57-12.56,36.89Z"/>
						</g>
						<g id="verres">
							<path class="cls-5-detail" d="M116.32,162.87c-.88,6.05.4,37.41,11.44,55.31s37.04,21.35,41.37,21.31,18.51,1.02,24.47-9.27c4.97-8.59,13.17-43.48,9.12-53.05-6.26-14.82-40.4-24.02-40.4-24.02,0,0-26.85-5.46-33.82-4.46,0,0-9.97-.96-12.17,14.17Z"/>
							<path class="cls-5-detail" d="M247.32,192.54s-1.09-9.55,19.57-16.69c11.76-4.06,60.46,3.23,60.46,3.23,0,0,19.09,4.06,21.71,8.28,2.62,4.22,9.46,17.24,8.29,37.97-1.14,20.21-7.31,26.8-12.61,30.31,0,0-7.1,4.93-21.34,5.93-26.65,1.88-37.01-1.14-46.19-7.73-29.88-21.46-29.88-61.3-29.88-61.3Z"/>
						</g>
					</g>
				</svg>
			`;
		}

		function displayMaterials(lunette: any) {
			const container = document.getElementById('materials-container');
			if (!container) return;

			const materiaux = lunette.materiaux || {};

			const html = `
				${materiaux.monture ? `
					<div class="flex items-center gap-3 p-3 bg-base-200 rounded-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
						</svg>
						<div class="flex-grow">
							<div class="font-semibold">Monture</div>
							<div class="text-sm text-base-content/70">${materiaux.monture.libelle || 'Non spécifié'}</div>
						</div>
					</div>
				` : ''}
				${materiaux.branches ? `
					<div class="flex items-center gap-3 p-3 bg-base-200 rounded-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
						<div class="flex-grow">
							<div class="font-semibold">Branches</div>
							<div class="text-sm text-base-content/70">${materiaux.branches.libelle || 'Non spécifié'}</div>
						</div>
					</div>
				` : ''}
				${materiaux.verres ? `
					<div class="flex items-center gap-3 p-3 bg-base-200 rounded-lg">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
						</svg>
						<div class="flex-grow">
							<div class="font-semibold">Verres</div>
							<div class="text-sm text-base-content/70">${materiaux.verres.libelle || 'Non spécifié'}</div>
						</div>
					</div>
				` : ''}
			`;

			container.innerHTML = html || '<p class="text-base-content/70">Aucun matériau spécifié</p>';
		}

		function showError() {
			document.getElementById('loader')?.classList.add('hidden');
			document.getElementById('error-message')?.classList.remove('hidden');
		}

		// Ajouter au panier
		document.getElementById('add-to-cart-btn')?.addEventListener('click', async () => {
			if (!lunetteId) return;

			try {
				await addToCart(lunetteId);
				
				// Toast de succès
				const toast = document.createElement('div');
				toast.className = 'toast toast-top toast-end';
				toast.innerHTML = `
					<div class="alert alert-success">
						<span>✅ Ajouté au panier !</span>
					</div>
				`;
				document.body.appendChild(toast);
				setTimeout(() => toast.remove(), 3000);

				// Rediriger vers le panier après 1s
				setTimeout(() => {
					window.location.href = '/panier';
				}, 1000);
			} catch (error) {
				console.error('❌ Erreur ajout panier:', error);
				alert('Erreur lors de l\'ajout au panier');
			}
		});

		// Supprimer
		document.getElementById('delete-btn')?.addEventListener('click', () => {
			const modal = document.getElementById('delete-modal') as HTMLDialogElement;
			modal?.showModal();
		});

		document.getElementById('confirm-delete-btn')?.addEventListener('click', async (e) => {
			e.preventDefault();
			
			if (!lunetteId) return;

			try {
				await deleteLunette(lunetteId);
				
				// Rediriger vers la galerie
				window.location.href = '/ma-galerie?deleted=true';
			} catch (error) {
				console.error('❌ Erreur suppression:', error);
				alert('Erreur lors de la suppression');
			}
		});

		// Charger les données au chargement
		loadLunetteDetails();
	</script>
</Layout>
