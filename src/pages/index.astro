---
import Layout from '../layouts/Layout.astro';
---

<Layout title="TaVue - Lunettes personnalisées">
	<!-- Hero Section -->
	<section class="hero min-h-[600px] bg-base-100">
		<div class="hero-content flex-col lg:flex-row-reverse gap-12 max-w-7xl px-6">
			<div class="flex-1 relative">
				<div class="bg-linear-to-br from-sky-200 to-sky-300 rounded-3xl p-8 shadow-xl">
					<img 
						src="/lunette-pour-le-hero.jpg" 
						alt="Lunettes TaVue sur fond bleu"
						class="rounded-2xl w-full h-auto object-cover"
					/>
					<div class="absolute top-8 right-8 bg-white rounded-full p-3 shadow-lg">
						<svg class="w-8 h-8 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
							<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
						</svg>
					</div>
				</div>
			</div>
			<div class="flex-1">
				<p class="text-sm uppercase tracking-wide text-neutral mb-2">Créez vos lunettes, affirmez-vous</p>
				<h1 class="text-5xl lg:text-6xl font-bold text-primary leading-tight mb-4">
					Lunettes<br />personnalisées.
				</h1>
				<h2 class="text-4xl lg:text-5xl font-light text-accent mb-6">
					Style unique.
				</h2>
				<p class="text-lg text-neutral mb-6 max-w-md">
					Concevez vos lunettes parfaites en quelques clics.<br />
					Choisissez votre matériau, vos couleurs et créez un style<br />
					100% unique qui vous ressemble.
				</p>
				<div class="flex flex-wrap gap-4">
					<a href="#creations" class="btn btn-primary text-primary-content px-8 py-3 text-base">
						🎨 Créer mes Lunettes
					</a>
					<a href="#gamme" class="btn btn-outline btn-primary px-8 py-3 text-base">
						Voir les créations
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Pourquoi choisir TaVue Section -->
	<section id="presentation" class="py-20 bg-base-200">
		<div class="max-w-7xl mx-auto px-6">
			<h2 class="text-4xl font-bold text-center text-primary mb-4">
				Pourquoi choisir TaVue ?
			</h2>
			<p class="text-center text-neutral mb-12 max-w-2xl mx-auto">
				Une approche en personnalisation unique qui vous accompagne vraiment
			</p>
			
			<div class="grid md:grid-cols-3 gap-8">
				<!-- Card 1 -->
				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow">
					<div class="card-body items-center text-center">
						<div class="bg-primary rounded-full p-6 mb-4">
							<svg class="w-12 h-12 text-primary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<h3 class="card-title text-2xl text-primary">Personnalisation Infinie</h3>
						<p class="text-neutral">
							Exprimez-vous ! Avec des lunettes uniques en choisissant parmi 6 montures premium, 6 couleurs de montures et le verre de votre choix.
						</p>
					</div>
				</div>

				<!-- Card 2 -->
				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow">
					<div class="card-body items-center text-center">
						<div class="bg-primary rounded-full p-6 mb-4">
							<svg class="w-12 h-12 text-primary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</div>
						<h3 class="card-title text-2xl text-primary">Qualité garantie</h3>
						<p class="text-neutral">
							Matériaux de qualité supérieure, verres avec protection UV400, et garantie 2 ans sur toutes nos créations.
						</p>
					</div>
				</div>

				<!-- Card 3 -->
				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow">
					<div class="card-body items-center text-center">
						<div class="bg-primary rounded-full p-6 mb-4">
							<svg class="w-12 h-12 text-primary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</div>
						<h3 class="card-title text-2xl text-primary">Clients satisfait</h3>
						<p class="text-neutral">
							+ 25 000 paires vendues<br />
							4.9/5 de satisfaction
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Inspirez-vous des créations Section -->
	<section id="gamme" class="py-20 bg-base-100">
		<div class="max-w-7xl mx-auto px-6">
			<h2 class="text-4xl font-bold text-center text-primary mb-4">
				Inspirez-vous des créations
			</h2>
			<p class="text-center text-neutral mb-12">
				Découvrez quelques exemples de lunettes personnalisées créées par nos clients.
			</p>
			
			<div class="grid md:grid-cols-3 gap-8 mb-12">
				<div class="card bg-base-200 shadow-lg overflow-hidden group cursor-pointer hover:shadow-xl transition-shadow">
					<figure class="h-64 overflow-hidden">
						<img 
							src="/lunette-Monture-noire-intemporelle.jpg" 
							alt="Lunettes noires sur texture jean"
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
						/>
					</figure>
					<div class="card-body">
						<h3 class="card-title text-primary">Le Classique</h3>
						<p class="text-neutral">Monture noire intemporelle</p>
					</div>
				</div>

				<div class="card bg-linear-to-br from-pink-200 to-pink-300 shadow-lg overflow-hidden group cursor-pointer hover:shadow-xl transition-shadow">
					<figure class="h-64 overflow-hidden">
						<img 
							src="/lunette-Monture-rose-délicate.jpg" 
							alt="Lunettes roses sur fond rose"
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
						/>
					</figure>
					<div class="card-body">
						<h3 class="card-title text-primary">La Romantique</h3>
						<p class="text-neutral">Monture rose délicate</p>
					</div>
				</div>

				<div class="card bg-linear-to-br from-sky-200 to-sky-300 shadow-lg overflow-hidden group cursor-pointer hover:shadow-xl transition-shadow">
					<figure class="h-64 overflow-hidden">
						<img 
							src="/lunette-Monture-moderne-et-colorée.jpg" 
							alt="Lunettes sur fond bleu"
							class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
						/>
					</figure>
					<div class="card-body">
						<h3 class="card-title text-primary">L'Audacieuse</h3>
						<p class="text-neutral">Monture moderne et colorée</p>
					</div>
				</div>
			</div>

			<div class="text-center">
				<a href="#creations" class="btn btn-primary text-primary-content px-8">
					Commencer ma création
				</a>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section id="creations" class="py-20 bg-primary text-primary-content">
		<div class="max-w-4xl mx-auto px-6 text-center">
			<h2 class="text-4xl lg:text-5xl font-bold mb-6">
				Prêt à créer vos lunettes parfaites ?
			</h2>
			<p class="text-xl mb-8 opacity-90">
				Rejoignez des milliers de clients satisfaits qui ont créé leurs lunettes uniques avec TaVue.<br />
				100% personnalisables. Livraison rapide partout en France.
			</p>
			<a href="/configurateur" class="btn btn-secondary text-secondary-content btn-lg px-12">
				Créer mes lunettes maintenant
			</a>
		</div>
	</section>
</Layout>
