---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inscription - TaVue" description="Créez votre compte TaVue">
	<div class="min-h-screen bg-base-100 flex items-center justify-center py-12 px-6">
		<div class="max-w-md w-full">
			<!-- Logo et titre -->
			<div class="text-center mb-8">
				<div class="flex justify-center mb-4">
					<div class="bg-primary rounded-full p-4">
						<svg class="w-8 h-8 text-primary-content" fill="currentColor" viewBox="0 0 20 20">
							<path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z" />
						</svg>
					</div>
				</div>
				<h1 class="text-3xl font-bold text-primary mb-2">Bienvenue sur TaVue</h1>
				<p class="text-neutral">Connectez-vous pour sauvegarder vos créations</p>
			</div>

			<!-- Card d'inscription -->
			<div class="card bg-base-100 shadow-xl border border-base-300">
				<div class="card-body">
					<!-- Messages -->
					<div id="error-message" class="alert alert-error hidden mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span></span>
					</div>
					<div id="success-message" class="alert alert-success hidden mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						<span></span>
					</div>

					<!-- Tabs -->
					<div class="tabs tabs-boxed mb-6 bg-base-200">
						<a href="/connexion" class="tab flex-1">Connexion</a>
						<a href="/inscription" class="tab tab-active flex-1">Créer un compte</a>
					</div>

					<!-- Formulaire d'inscription -->
					<form id="register-form" class="space-y-4">
						<!-- Nom complet -->
						<div class="form-control">
							<label class="label">
								<span class="label-text font-semibold">Nom complet</span>
							</label>
							<input 
								type="text" 
								name="name"
								placeholder="Jean Dupont" 
								class="input input-bordered w-full"
								required
							/>
						</div>

						<!-- Email -->
						<div class="form-control">
							<label class="label">
								<span class="label-text font-semibold">Email</span>
							</label>
							<input 
								type="email" 
								name="email"
								placeholder="votre@email.com" 
								class="input input-bordered w-full"
								required
							/>
						</div>

						<!-- Mot de passe -->
						<div class="form-control">
							<label class="label">
								<span class="label-text font-semibold">Mot de passe</span>
							</label>
							<input 
								type="password" 
								name="password"
								placeholder="••••••••" 
								class="input input-bordered w-full"
								required
								minlength="8"
							/>
							<label class="label">
								<span class="label-text-alt text-neutral">Minimum 8 caractères</span>
							</label>
						</div>

						<!-- Confirmation mot de passe -->
						<div class="form-control">
							<label class="label">
								<span class="label-text font-semibold">Confirmer le mot de passe</span>
							</label>
							<input 
								type="password" 
								name="password-confirm"
								placeholder="••••••••" 
								class="input input-bordered w-full"
								required
								minlength="8"
							/>
						</div>

						<!-- Checkbox CGV -->
						<div class="form-control">
							<label class="label cursor-pointer justify-start gap-3">
								<input type="checkbox" name="terms" class="checkbox checkbox-primary" required />
								<span class="label-text">
									J'accepte les 
									<a href="#" class="link link-primary">conditions générales</a> 
									et la 
									<a href="#" class="link link-primary">politique de confidentialité</a>
								</span>
							</label>
						</div>

						<!-- Bouton d'inscription -->
						<button type="submit" class="btn btn-primary w-full">
							Créer mon compte
						</button>
					</form>

					<!-- Divider -->
					<div class="divider">OU</div>

					<!-- Connexion avec Google -->
					<button type="button" id="google-register-btn" class="btn btn-outline w-full gap-2">
						<svg class="w-5 h-5" viewBox="0 0 24 24">
							<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
							<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
							<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
							<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
						</svg>
						S'inscrire avec Google
					</button>

					<!-- Lien vers connexion -->
					<p class="text-center text-sm text-neutral mt-4">
						Vous avez déjà un compte ? 
						<a href="/connexion" class="link link-primary font-semibold">Se connecter</a>
					</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		import { register, loginWithGoogle, isAuthenticated } from '../JS/pocketbase.js';

		// Si déjà connecté ET qu'il y a un returnUrl, rediriger
		// Sinon, laisser l'utilisateur sur la page d'inscription
		const urlParams = new URLSearchParams(window.location.search);
		const returnUrl = urlParams.get('returnUrl');
		
		if (isAuthenticated() && returnUrl) {
			window.location.href = returnUrl;
		}

		// Message d'erreur
		function showError(message: string) {
			const errorDiv = document.getElementById('error-message');
			if (errorDiv) {
				const span = errorDiv.querySelector('span');
				if (span) span.textContent = message;
				errorDiv.classList.remove('hidden');
				setTimeout(() => errorDiv.classList.add('hidden'), 5000);
			} else {
				alert(message);
			}
		}

		function showSuccess(message: string) {
			const successDiv = document.getElementById('success-message');
			if (successDiv) {
				const span = successDiv.querySelector('span');
				if (span) span.textContent = message;
				successDiv.classList.remove('hidden');
			}
		}

		// Formulaire d'inscription
		const registerForm = document.getElementById('register-form');
		registerForm?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const form = e.target as HTMLFormElement;
			const formData = new FormData(form);
			const name = formData.get('name') as string;
			const email = formData.get('email') as string;
			const password = formData.get('password') as string;
			const passwordConfirm = formData.get('password-confirm') as string;

			// Vérifier que les mots de passe correspondent
			if (password !== passwordConfirm) {
				showError('Les mots de passe ne correspondent pas');
				return;
			}

			// Vérifier la longueur du mot de passe
			if (password.length < 8) {
				showError('Le mot de passe doit contenir au moins 8 caractères');
				return;
			}

			try {
				const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
				if (btn) {
					btn.disabled = true;
					btn.innerHTML = '<span class="loading loading-spinner"></span> Création du compte...';
				}

				await register(email, password, passwordConfirm, name);
				
				showSuccess('Compte créé avec succès ! Un email de vérification vous a été envoyé. Redirection...');
				form.reset();
				
				// Rediriger vers la page de connexion avec returnUrl
				const urlParams = new URLSearchParams(window.location.search);
				const returnUrl = urlParams.get('returnUrl') || '/';
				
				setTimeout(() => {
					window.location.href = `/connexion?returnUrl=${encodeURIComponent(returnUrl)}`;
				}, 3000);
			} catch (error: any) {
				console.error('Erreur d\'inscription:', error);
				
				let errorMessage = 'Échec de la création du compte.';
				if (error.data?.email) {
					errorMessage = 'Cet email est déjà utilisé.';
				} else if (error.message) {
					errorMessage = error.message;
				}
				
				showError(errorMessage);
				
				const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
				if (btn) {
					btn.disabled = false;
					btn.innerHTML = 'Créer mon compte';
				}
			}
		});

		// Inscription avec Google
		const googleRegisterBtn = document.getElementById('google-register-btn') as HTMLButtonElement;
		googleRegisterBtn?.addEventListener('click', async () => {
			try {
				googleRegisterBtn.disabled = true;
				googleRegisterBtn.innerHTML = '<span class="loading loading-spinner"></span> Inscription avec Google...';

				await loginWithGoogle();
				
				showSuccess('Inscription Google réussie ! Redirection...');
				setTimeout(() => {
					window.location.href = '/';
				}, 1000);
			} catch (error: any) {
				console.error('Erreur d\'inscription Google:', error);
				showError('Échec de l\'inscription avec Google. Veuillez réessayer.');
				
				googleRegisterBtn.disabled = false;
				googleRegisterBtn.innerHTML = `
					<svg class="w-5 h-5" viewBox="0 0 24 24">
						<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
						<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
						<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
						<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
					</svg>
					S'inscrire avec Google
				`;
			}
		});
	</script>
</Layout>
