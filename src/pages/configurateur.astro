---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configurateur - TaVue" description="Créez vos lunettes personnalisées en quelques clics">
	<div class="min-h-screen flex items-center justify-center bg-base-200">
		<div class="text-center max-w-2xl px-6">
			<h1 class="text-5xl font-bold text-primary mb-6">🎨 Configurateur</h1>
			<p class="text-xl text-neutral mb-8">
				Le configurateur de lunettes arrive bientôt !<br />
				Vous pourrez personnaliser entièrement vos lunettes.
			</p>
			<div class="card bg-base-100 shadow-xl p-8">
				<h2 class="text-2xl font-semibold mb-4">Fonctionnalités à venir :</h2>
				<ul class="text-left space-y-3 mb-6">
					<li class="flex items-start gap-2">
						<span class="text-success text-xl">✓</span>
						<span>Choix de la monture (6 modèles)</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-success text-xl">✓</span>
						<span>Sélection des couleurs personnalisées</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-success text-xl">✓</span>
						<span>Choix du matériau des verres</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-success text-xl">✓</span>
						<span>Aperçu 3D en temps réel</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-success text-xl">✓</span>
						<span>Génération IA pour suggestions</span>
					</li>
				</ul>
			</div>
			<a href="/" class="btn btn-primary mt-8">
				← Retour à l'accueil
			</a>
		</div>
	</div>
</Layout>
