---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Configurateur - TaVue" description="Créez vos lunettes personnalisées en quelques clics">
	<!-- Modal de connexion requise (visible par défaut) -->
	<div id="auth-modal" class="modal modal-open">
		<div class="modal-box relative max-w-md mx-auto">
			<!-- Bouton de fermeture -->
			<button 
				class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" 
				onclick="window.location.href='/'"
				aria-label="Fermer"
			>
				✕
			</button>
			
			<h3 class="font-bold text-xl mb-4">Connexion requise</h3>
			<p class="py-4 text-base">
				Vous devez être connecté pour accéder au configurateur de lunettes et créer vos modèles personnalisés.
			</p>
			
			<div class="modal-action justify-center gap-3">
				<a href="/inscription?returnUrl=/configurateur" class="btn btn-primary">
					Créer un compte
				</a>
				<a href="/connexion?returnUrl=/configurateur" class="btn btn-outline">
					Se connecter
				</a>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop bg-black/50" onclick="window.location.href='/'">
			<button>close</button>
		</form>
	</div>

	<!-- Contenu du configurateur (caché par défaut) -->
	<div class="min-h-screen bg-base-100 py-8" id="configurator-content" style="display: none; visibility: hidden;">
		<div class="max-w-7xl mx-auto px-6">
			<!-- Header -->
			<div class="text-center mb-8">
				<h1 class="text-4xl font-bold text-primary mb-4">Créez vos lunettes</h1>
				<p class="text-neutral max-w-2xl mx-auto">
					Personnalisez votre paire de lunettes selon vos envies. Choisissez la monture, les verres et créez un style unique.
				</p>
			</div>

			<!-- Stats & Badges -->
			<div class="flex justify-center gap-4 mb-8 flex-wrap">
				<div class="badge badge-lg bg-success/20 text-success border-success">
					🌱 Made in France
				</div>
				<div class="badge badge-lg bg-info/20 text-info border-info">
					♻️ Verres recyclés
				</div>
				<div class="flex items-center gap-2 text-sm text-neutral">
					<span class="font-semibold">🎨 <span id="config-count">314</span></span>
					<span>configurations cette semaine</span>
				</div>
			</div>

			<!-- Progress Steps -->
			<div class="mb-8">
				<ul class="steps steps-horizontal w-full text-xs">
					<li class="step step-primary" data-step="0">Édition</li>
					<li class="step" data-step="1">Matériau</li>
					<li class="step" data-step="2">Taille</li>
					<li class="step" data-step="3">Dimensions</li>
					<li class="step" data-step="4">Couleurs</li>
					<li class="step" data-step="5">Signature</li>
				</ul>
			</div>

			<!-- Main Content Grid -->
			<div class="grid lg:grid-cols-2 gap-8">
				<!-- Left: Configuration Panel -->
				<div class="bg-base-100 rounded-2xl p-6 shadow-lg">
					<!-- Step 0: Choisir l'édition -->
					<div id="step-0" class="step-content">
						<h2 class="text-2xl font-bold mb-4">Étape 1 sur 5<br/><span class="text-primary">Choisissez votre édition</span></h2>
						<p class="text-neutral mb-6">Sélectionnez le niveau de finition souhaité</p>
						
						<div class="space-y-4">
							<!-- Edition Classique -->
							<div class="card bg-base-200 border-2 border-transparent hover:border-primary cursor-pointer transition-all edition-card" data-edition="classique" data-price="159">
								<div class="card-body">
									<div class="flex justify-between items-start">
										<div>
											<h3 class="font-bold text-lg">Édition Classique</h3>
											<p class="text-sm text-neutral">Design intemporel</p>
										</div>
										<div class="text-right">
											<p class="text-2xl font-bold">159 €</p>
											<p class="text-xs text-neutral">+ matériau</p>
										</div>
									</div>
									<ul class="mt-4 space-y-2 text-sm">
										<li class="flex items-center gap-2">
											<svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
											Verres anti-reflets
										</li>
										<li class="flex items-center gap-2">
											<svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
											Étui inclus
										</li>
									</ul>
								</div>
							</div>

							<!-- Edition Atelier -->
							<div class="card bg-base-200 border-2 border-transparent hover:border-primary cursor-pointer transition-all edition-card" data-edition="atelier" data-price="199">
								<div class="card-body">
									<div class="flex justify-between items-start">
										<div>
											<h3 class="font-bold text-lg">Édition Atelier</h3>
											<p class="text-sm text-neutral">Finitions artisanales</p>
										</div>
										<div class="text-right">
											<p class="text-2xl font-bold">199 €</p>
											<p class="text-xs text-neutral">+ matériau</p>
										</div>
									</div>
									<ul class="mt-4 space-y-2 text-sm">
										<li class="flex items-center gap-2">
											<svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
											Verres anti-reflets + UV400
										</li>
										<li class="flex items-center gap-2">
											<svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
											Étui premium cuir
										</li>
										<li class="flex items-center gap-2">
											<svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
											Gravure personnalisée
										</li>
									</ul>
								</div>
							</div>
						</div>
					</div>

					<!-- Step 1: Sélectionner le matériau -->
					<div id="step-1" class="step-content hidden">
						<h2 class="text-2xl font-bold mb-4">Étape 2 sur 6<br/><span class="text-primary">Sélectionnez le matériau</span></h2>
						<p class="text-neutral mb-6">Chaque matériau offre une expérience unique</p>
						
						<div id="materials-container" class="space-y-4">
							<!-- Les matériaux seront chargés dynamiquement depuis PocketBase -->
							<div class="flex justify-center py-8">
								<span class="loading loading-spinner loading-lg"></span>
							</div>
						</div>

						<div class="alert alert-warning mt-6">
							<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
							<span class="text-sm">Série Écaille - Réassort vendredi prochain</span>
						</div>
					</div>

					<!-- Step 2: Choisir la taille -->
					<div id="step-2" class="step-content hidden">
						<h2 class="text-2xl font-bold mb-4">Étape 3 sur 6<br/><span class="text-primary">Choisissez votre taille</span></h2>
						<p class="text-neutral mb-6">Sélectionnez la taille globale de la monture selon votre morphologie</p>
						
						<div class="grid grid-cols-1 gap-4">
							<!-- Visage Fin -->
							<div class="card bg-base-200 border-2 border-transparent hover:border-primary cursor-pointer transition-all size-card" data-size="S" data-width="48">
								<div class="card-body">
									<div class="flex items-center gap-4">
										<div class="avatar placeholder">
											<div class="bg-neutral text-neutral-content rounded-full w-12">
												<span class="text-xl">S</span>
											</div>
										</div>
										<div>
											<h3 class="font-bold">Petit - 48mm</h3>
											<p class="text-sm text-neutral">Visage fin</p>
										</div>
									</div>
								</div>
							</div>

							<!-- Visage Standard -->
							<div class="card bg-base-200 border-2 border-transparent hover:border-primary cursor-pointer transition-all size-card" data-size="M" data-width="52">
								<div class="card-body">
									<div class="flex items-center gap-4">
										<div class="avatar placeholder">
											<div class="bg-neutral text-neutral-content rounded-full w-12">
												<span class="text-xl">M</span>
											</div>
										</div>
										<div>
											<h3 class="font-bold">Moyen - 52mm</h3>
											<p class="text-sm text-neutral">Visage standard</p>
											<span class="badge badge-sm badge-primary">Recommandé</span>
										</div>
									</div>
								</div>
							</div>

							<!-- Visage Large -->
							<div class="card bg-base-200 border-2 border-transparent hover:border-primary cursor-pointer transition-all size-card" data-size="L" data-width="56">
								<div class="card-body">
									<div class="flex items-center gap-4">
										<div class="avatar placeholder">
											<div class="bg-neutral text-neutral-content rounded-full w-12">
												<span class="text-xl">L</span>
											</div>
										</div>
										<div>
											<h3 class="font-bold">Grand - 56mm</h3>
											<p class="text-sm text-neutral">Visage large</p>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="alert alert-info mt-6">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span class="text-sm">💡 La taille M convient à la majorité des morphologies. Vous pourrez affiner les dimensions à l'étape suivante.</span>
						</div>
					</div>

					<!-- Step 3: Dimensions détaillées -->
					<div id="step-3" class="step-content hidden">
						<h2 class="text-2xl font-bold mb-4">Étape 4 sur 6<br/><span class="text-primary">Affinez les dimensions</span></h2>
						<p class="text-neutral mb-6">Personnalisez les mesures précises de vos lunettes (en millimètres)</p>
						
						<div class="grid grid-cols-1 gap-4">
							<!-- Largeur du pont -->
							<div class="form-control">
								<label class="label">
									<span class="label-text font-semibold">Largeur du pont (mm)</span>
									<span class="label-text-alt text-neutral">Distance entre les verres</span>
								</label>
								<input 
									type="number" 
									id="largeur-pont-input"
									placeholder="Ex: 18" 
									min="14"
									max="24"
									class="input input-bordered w-full"
								/>
								<label class="label">
									<span class="label-text-alt">Recommandé: 16-20mm</span>
								</label>
							</div>

							<!-- Largeur du verre -->
							<div class="form-control">
								<label class="label">
									<span class="label-text font-semibold">Largeur du verre (mm)</span>
									<span class="label-text-alt text-neutral">Largeur de chaque verre</span>
								</label>
								<input 
									type="number" 
									id="largeur-verre-input"
									placeholder="Ex: 52" 
									min="45"
									max="60"
									class="input input-bordered w-full"
								/>
								<label class="label">
									<span class="label-text-alt">Recommandé: 48-56mm</span>
								</label>
							</div>

							<!-- Hauteur du verre -->
							<div class="form-control">
								<label class="label">
									<span class="label-text font-semibold">Hauteur du verre (mm)</span>
									<span class="label-text-alt text-neutral">Hauteur de chaque verre</span>
								</label>
								<input 
									type="number" 
									id="hauteur-verre-input"
									placeholder="Ex: 40" 
									min="30"
									max="55"
									class="input input-bordered w-full"
								/>
								<label class="label">
									<span class="label-text-alt">Recommandé: 35-45mm</span>
								</label>
							</div>

							<!-- Longueur de la branche -->
							<div class="form-control">
								<label class="label">
									<span class="label-text font-semibold">Longueur branche (mm)</span>
									<span class="label-text-alt text-neutral">Longueur totale des branches</span>
								</label>
								<input 
									type="number" 
									id="longueur-branche-input"
									placeholder="Ex: 145" 
									min="130"
									max="155"
									class="input input-bordered w-full"
								/>
								<label class="label">
									<span class="label-text-alt">Recommandé: 140-150mm</span>
								</label>
							</div>
						</div>

						<div class="alert alert-info mt-6">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<span class="text-sm">Les dimensions détaillées sont optionnelles. Si non renseignées, nous utiliserons les dimensions standards selon la taille choisie.</span>
						</div>
					</div>

					<!-- Step 4: Personnaliser les couleurs -->
					<div id="step-4" class="step-content hidden">
						<h2 class="text-2xl font-bold mb-4">Étape 5 sur 6<br/><span class="text-primary">Personnalisez les teintes</span></h2>
						<p class="text-neutral mb-6">Exprimez votre style personnel</p>
						
						<!-- Couleur de la monture -->
						<div class="mb-6">
							<h3 class="font-semibold mb-3">Couleur de monture</h3>
							<div class="flex gap-3 flex-wrap">
								<button class="color-btn w-12 h-12 rounded-full border-2 border-primary shadow-lg" data-part="monture" data-color="#000000" style="background-color: #000000;" title="Noir"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="monture" data-color="#8B4513" style="background-color: #8B4513;" title="Marron"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="monture" data-color="#1E40AF" style="background-color: #1E40AF;" title="Bleu"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="monture" data-color="#DB2777" style="background-color: #DB2777;" title="Rose"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="monture" data-color="#D1D5DB" style="background-color: #D1D5DB;" title="Gris"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="monture" data-color="#EAB308" style="background-color: #EAB308;" title="Jaune"></button>
							</div>
						</div>

						<!-- Couleur des branches -->
						<div class="mb-6">
							<h3 class="font-semibold mb-3">Couleur des branches</h3>
							<div class="flex gap-3 flex-wrap">
								<button class="color-btn w-12 h-12 rounded-full border-2 border-primary shadow-lg" data-part="branches" data-color="#000000" style="background-color: #000000;" title="Noir"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="branches" data-color="#8B4513" style="background-color: #8B4513;" title="Marron"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="branches" data-color="#1E40AF" style="background-color: #1E40AF;" title="Bleu"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="branches" data-color="#DB2777" style="background-color: #DB2777;" title="Rose"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="branches" data-color="#D1D5DB" style="background-color: #D1D5DB;" title="Gris"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="branches" data-color="#EAB308" style="background-color: #EAB308;" title="Jaune"></button>
							</div>
						</div>

						<!-- Couleur des verres -->
						<div class="mb-6">
							<h3 class="font-semibold mb-3">Couleur des verres</h3>
							<div class="flex gap-3 flex-wrap">
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="verres" data-color="#E0F2FE" style="background-color: #E0F2FE;" title="Transparent"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="verres" data-color="#6B7280" style="background-color: #6B7280;" title="Gris"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="verres" data-color="#1E40AF" style="background-color: #1E40AF;" title="Bleu"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="verres" data-color="#10B981" style="background-color: #10B981;" title="Vert"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="verres" data-color="#92400E" style="background-color: #92400E;" title="Marron"></button>
								<button class="color-btn w-12 h-12 rounded-full border-2 border-transparent hover:border-primary shadow-lg" data-part="verres" data-color="#FFC0CB" style="background-color: #FFC0CB;" title="Rose"></button>
							</div>
						</div>
					</div>

					<!-- Step 5: Signer la création -->
					<div id="step-5" class="step-content hidden">
						<h2 class="text-2xl font-bold mb-4">Étape 6 sur 6<br/><span class="text-primary">Signez votre création</span></h2>
						<p class="text-neutral mb-6">Donnez vie à vos lunettes avec un nom personnel. Cette signature apparaîtra sur votre modèle.</p>
						
						<div class="form-control mb-6">
							<label class="label">
								<span class="label-text font-semibold">Votre signature</span>
								<span class="label-text-alt text-neutral">Ex: Élégance Parisienne, Audace Urbaine...</span>
							</label>
							<input 
								type="text" 
								id="signature-input"
								placeholder="Ex: Élégance Parisienne, Audace Urbaine..." 
								class="input input-bordered w-full" 
								maxlength="50"
							/>
							<label class="label">
								<span class="label-text-alt">Requis pour sauvegarder et ajuster au fil du temps</span>
							</label>
						</div>

						<div class="alert alert-info">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<div>
								<div class="font-bold">Conseil : Un nom évocateur rend votre création unique et mémorable.</div>
								<div class="text-sm">Astuce : Un nom évocateur facilite les ajustements et créations futures.</div>
							</div>
						</div>

						<div class="mt-6 space-y-3">
							<button class="btn btn-outline w-full" id="save-config-btn">
								💾 Sauvegarder uniquement
							</button>
							<button class="btn btn-outline w-full" id="restart-config-btn">
								🔄 Réinitialiser la configuration
							</button>
						</div>
					</div>

					<!-- Navigation Buttons -->
					<div class="flex gap-4 mt-8">
						<button id="prev-btn" class="btn btn-outline flex-1" disabled>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
							</svg>
							Précédent
						</button>
						<button id="next-btn" class="btn btn-primary flex-1">
							Suivant
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
							</svg>
						</button>
					</div>
				</div>

				<!-- Right: Preview -->
				<div class="bg-base-200 rounded-2xl p-8 shadow-lg sticky top-24 h-fit">
					<h3 class="text-xl font-bold mb-4 text-center">Aperçu en temps réel</h3>
					
					<!-- SVG Preview -->
					<div class="bg-base-100 rounded-xl p-8 mb-4 flex items-center justify-center">
						<div id="glasses-preview" class="w-full max-w-md">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="80 100 440 200" class="w-full h-auto">
								<g id="branches-svg">
									<path class="branches-color" fill="#000000" stroke="#1d1d1b" stroke-width="0.5" d="M108.83,155.14s49.35-5.57,54.93-8.76,11.14-7.96,19.5-9.55,64.48-11.14,64.48-11.14c0,0,7.16-1.99,17.51,5.57s33.04,31.84,39.4,31.05c6.37-.8,9.55-9.55,7.56-13.53s-40.67-32.75-47.36-34.63c-9.53-2.68-21.89-2.39-37.02,0-15.12,2.39-116.22,23.34-116.22,23.34,0,0-13.13,6.12-2.79,17.66Z"/>
									<path class="branches-color" fill="#000000" stroke="#1d1d1b" stroke-width="0.5" d="M374.79,179.65l90.54-29.78s22.13-5.63,25.35-4.02,17.71,30.58,17.71,33.8-2.42,14.01-5.63,14.89c-2.33.64-5.33.11-6.84-4.21-1.41-4.02-6.84-31.73-12.47-31.47s-50.7,15.95-50.7,15.95c0,0-13.28,6.44-18.91,11.27s-32.19,11.27-32.19,11.27c0,0-9.66-7.65-6.84-17.71Z"/>
								</g>
								<g id="monture-svg">
									<path class="monture-color" fill="#000000" stroke="#1d1d1b" stroke-width="0.5" d="M385.31,180.81c-.24-3.41-9.57-5.22-12.71-6.4-3.14-1.18-15.7,1.96-15.7,1.96-12.17-3.14-54.55-9.03-78.88-9.03s-32.57,11.38-35.32,10.99c-2.75-.39-17.27-.78-23.55-1.96-6.28-1.18-5.1-14.13-39.25-26.48-34.14-12.35-68.29-12.42-68.29-12.42-13.35,4.66-6.76,18.49-6.76,18.49l2.05,6.35c4.32,2.03,3.14,10.52,4.71,23.08s7.46,28.65,14.13,38.46c6.67,9.81,31.79,20.8,44.35,21.19s23.55-1.96,31.79-15.31c8.24-13.34,16.88-36.89,16.88-36.89l10.2,1.57s2.91.31,5.35,3.09,4.43,8.03,7.6,17.31c7.56,22.1,25.12,39.25,25.12,39.25,0,0,5.6,7.43,33.44,12.66,23.08,4.34,42.7-2.46,42.7-2.46,17.72-7.17,21.63-44.96,21.63-44.96,0,0,1.83-13.3,7.81-16.65,7.37-4.14,8.27-4.44,12.71-5.32,3.61-.71.24-13.13,0-16.54Z"/>
								</g>
								<g id="verres-svg">
									<path class="verres-color" fill="#E0F2FE" opacity="0.75" d="M116.32,162.87c-.88,6.05.4,37.41,11.44,55.31s37.04,21.35,41.37,21.31,18.51,1.02,24.47-9.27c4.97-8.59,13.17-43.48,9.12-53.05-6.26-14.82-40.4-24.02-40.4-24.02,0,0-26.85-5.46-33.82-4.46,0,0-9.97-.96-12.17,14.17Z"/>
									<path class="verres-color" fill="#E0F2FE" opacity="0.75" d="M247.32,192.54s-1.09-9.55,19.57-16.69c11.76-4.06,60.46,3.23,60.46,3.23,0,0,19.09,4.06,21.71,8.28,2.62,4.22,9.46,17.24,8.29,37.97-1.14,20.21-7.31,26.8-12.61,30.31,0,0-7.1,4.93-21.34,5.93-26.65,1.88-37.01-1.14-46.19-7.73-29.88-21.46-29.88-61.3-29.88-61.3Z"/>
								</g>
							</svg>
						</div>
					</div>

					<!-- Price Summary -->
					<div class="card bg-base-100">
						<div class="card-body">
							<h4 class="font-semibold mb-4">Prix estimé</h4>
							<div class="space-y-2 text-sm">
								<div class="flex justify-between">
									<span>Édition</span>
									<span class="font-semibold" id="edition-label">Classique</span>
								</div>
								<div class="flex justify-between">
									<span>Matériau</span>
									<span class="font-semibold" id="material-label">Acétate</span>
								</div>
								<div class="flex justify-between">
									<span>Taille</span>
									<span class="font-semibold" id="size-label">M (52mm)</span>
								</div>
								<div class="divider my-2"></div>
								<div class="flex justify-between text-lg font-bold">
									<span>Prix estimé</span>
									<span class="text-primary" id="total-price">159.00 €</span>
								</div>
							</div>
							<button class="btn btn-primary btn-block mt-4" id="add-to-cart-btn">
								🛒 Ajouter au panier
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		// Configuration state
		let currentStep = 0;
		const totalSteps = 6;
		let config = {
			edition: 'classique',
			editionPrice: 159,
			material: 'acetate',
			materialPrice: 0,
			size: 'M',
			sizeWidth: 52,
			largeurPont: null as number | null,
			largeurVerre: null as number | null,
			hauteurVerre: null as number | null,
			longueurBranche: null as number | null,
			colors: {
				monture: '#000000',
				branches: '#000000',
				verres: '#E0F2FE'
			},
			signature: ''
		};

		// DOM Elements
		const prevBtn = document.getElementById('prev-btn');
		const nextBtn = document.getElementById('next-btn');
		const steps = document.querySelectorAll('.step');
		const stepContents = document.querySelectorAll('.step-content');

		// Initialize
		updateStepDisplay();
		updatePrice();
		loadMaterials(); // Charger les matériaux depuis PocketBase

		// Fonction pour charger les matériaux depuis PocketBase
		import { getMateriaux } from '../JS/pocketbase.js';
		
		async function loadMaterials() {
			const container = document.getElementById('materials-container');
			if (!container) return;

			try {
				const materiaux = await getMateriaux();
				
				if (materiaux.length === 0) {
					container.innerHTML = '<p class="text-center text-neutral">Aucun matériau disponible</p>';
					return;
				}

				container.innerHTML = '';
				
				materiaux.forEach((materiau, index) => {
					const isFirst = index === 0;
					const card = document.createElement('div');
					card.className = `card bg-base-200 border-2 ${isFirst ? 'border-4 border-primary' : 'border-transparent hover:border-primary'} cursor-pointer transition-all material-card`;
					card.setAttribute('data-material', materiau.libelle.toLowerCase());
					card.setAttribute('data-price', materiau.prix.toString());
					
					card.innerHTML = `
						<div class="card-body">
							<div class="flex justify-between items-start">
								<div>
									<h3 class="font-bold text-lg flex items-center gap-2">
										${materiau.libelle}
										${isFirst ? '<span class="badge badge-error badge-sm">🔥 Plus vendu</span>' : ''}
									</h3>
									<p class="text-sm text-neutral">${materiau.description || 'Matériau de qualité'}</p>
								</div>
								<div class="text-right">
									<p class="text-2xl font-bold">+${materiau.prix} €</p>
								</div>
							</div>
						</div>
					`;
					
					container.appendChild(card);
					
					// Si c'est le premier matériau, le définir par défaut
					if (isFirst) {
						config.material = materiau.libelle.toLowerCase();
						config.materialPrice = materiau.prix;
					}
				});
				
				// Attacher les event listeners après avoir créé les cartes
				attachMaterialListeners();
				
			} catch (error) {
				console.error('Erreur de chargement des matériaux:', error);
				container.innerHTML = '<p class="text-center text-error">Erreur de chargement des matériaux</p>';
			}
		}

		// Fonction pour attacher les listeners aux cartes de matériaux
		function attachMaterialListeners() {
			document.querySelectorAll('.material-card').forEach(card => {
				card.addEventListener('click', () => {
					document.querySelectorAll('.material-card').forEach(c => {
						c.classList.remove('border-primary', 'border-4');
						c.classList.add('border-2', 'border-transparent');
					});
					card.classList.remove('border-2', 'border-transparent');
					card.classList.add('border-4', 'border-primary');
					
					const cardElement = card as HTMLElement;
					config.material = cardElement.dataset.material || '';
					config.materialPrice = parseInt(cardElement.dataset.price || '0');
					updatePrice();
				});
			});
		}

		// Navigation
		prevBtn?.addEventListener('click', () => {
			if (currentStep > 0) {
				currentStep--;
				updateStepDisplay();
			}
		});

		nextBtn?.addEventListener('click', () => {
			if (currentStep < totalSteps - 1) {
				currentStep++;
				updateStepDisplay();
			}
		});

		function updateStepDisplay() {
			// Update step indicators
			steps.forEach((step, index) => {
				if (index <= currentStep) {
					step.classList.add('step-primary');
				} else {
					step.classList.remove('step-primary');
				}
			});

			// Update content visibility
			stepContents.forEach((content, index) => {
				if (index === currentStep) {
					content.classList.remove('hidden');
				} else {
					content.classList.add('hidden');
				}
			});

			// Update buttons
			if (prevBtn) {
				prevBtn.disabled = currentStep === 0;
			}
			if (nextBtn) {
				if (currentStep === totalSteps - 1) {
					nextBtn.textContent = '✓ Terminer';
					nextBtn.classList.remove('btn-primary');
					nextBtn.classList.add('btn-success');
				} else {
					nextBtn.innerHTML = 'Suivant <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>';
					nextBtn.classList.add('btn-primary');
					nextBtn.classList.remove('btn-success');
				}
			}
		}

		// Edition selection
		document.querySelectorAll('.edition-card').forEach(card => {
			card.addEventListener('click', () => {
				document.querySelectorAll('.edition-card').forEach(c => {
					c.classList.remove('border-primary', 'border-4');
					c.classList.add('border-2', 'border-transparent');
				});
				card.classList.remove('border-2', 'border-transparent');
				card.classList.add('border-4', 'border-primary');
				config.edition = card.dataset.edition;
				config.editionPrice = parseInt(card.dataset.price);
				updatePrice();
			});
		});

		// Material selection est gérée par attachMaterialListeners() appelée après le chargement dynamique

		// Size selection
		document.querySelectorAll('.size-card').forEach(card => {
			card.addEventListener('click', () => {
				document.querySelectorAll('.size-card').forEach(c => {
					c.classList.remove('border-primary', 'border-4');
					c.classList.add('border-2', 'border-transparent');
				});
				card.classList.remove('border-2', 'border-transparent');
				card.classList.add('border-4', 'border-primary');
				const cardElement = card as HTMLElement;
				config.size = cardElement.dataset.size || '';
				config.sizeWidth = cardElement.dataset.width || '';
				updatePrice();
			});
		});
		
		// Sélectionner par défaut les premières options
		document.querySelector('.edition-card')?.classList.add('border-4', 'border-primary');
		document.querySelector('.edition-card')?.classList.remove('border-2', 'border-transparent');
		
		// La sélection par défaut du matériau est gérée dans loadMaterials()
		
		const defaultSizeCard = document.querySelector('.size-card[data-size="M"]');
		if (defaultSizeCard) {
			defaultSizeCard.classList.add('border-4', 'border-primary');
			defaultSizeCard.classList.remove('border-2', 'border-transparent');
		}

		// Dimensions inputs
		const largeurPontInput = document.getElementById('largeur-pont-input') as HTMLInputElement;
		const largeurVerreInput = document.getElementById('largeur-verre-input') as HTMLInputElement;
		const hauteurVerreInput = document.getElementById('hauteur-verre-input') as HTMLInputElement;
		const longueurBrancheInput = document.getElementById('longueur-branche-input') as HTMLInputElement;

		largeurPontInput?.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			config.largeurPont = parseInt(target.value) || null;
		});

		largeurVerreInput?.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			config.largeurVerre = parseInt(target.value) || null;
		});

		hauteurVerreInput?.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			config.hauteurVerre = parseInt(target.value) || null;
		});

		longueurBrancheInput?.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			config.longueurBranche = parseInt(target.value) || null;
		});

		// Color selection
		document.querySelectorAll('.color-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const part = btn.dataset.part;
				const color = btn.dataset.color;
				
				// Update active state
				document.querySelectorAll(`.color-btn[data-part="${part}"]`).forEach(b => {
					b.classList.remove('border-primary');
					b.classList.add('border-transparent');
				});
				btn.classList.add('border-primary');
				btn.classList.remove('border-transparent');
				
				// Update config
				config.colors[part] = color;
				
				// Update SVG
				updateGlassesPreview();
			});
		});

		function updateGlassesPreview() {
			const branchesElements = document.querySelectorAll('.branches-color');
			const montureElements = document.querySelectorAll('.monture-color');
			const verresElements = document.querySelectorAll('.verres-color');
			
			branchesElements.forEach(el => el.setAttribute('fill', config.colors.branches));
			montureElements.forEach(el => el.setAttribute('fill', config.colors.monture));
			verresElements.forEach(el => el.setAttribute('fill', config.colors.verres));
		}

		function updatePrice() {
			const total = config.editionPrice + config.materialPrice;
			document.getElementById('total-price').textContent = total.toFixed(2) + ' €';
			document.getElementById('edition-label').textContent = config.edition.charAt(0).toUpperCase() + config.edition.slice(1);
			document.getElementById('material-label').textContent = config.material.charAt(0).toUpperCase() + config.material.slice(1);
			document.getElementById('size-label').textContent = `${config.size} (${config.sizeWidth}mm)`;
		}

		// Signature input
		document.getElementById('signature-input')?.addEventListener('input', (e) => {
			const target = e.target as HTMLInputElement;
			config.signature = target.value;
		});

		// Save configuration
		import { saveLunette } from '../JS/pocketbase.js';
		
		document.getElementById('save-config-btn')?.addEventListener('click', async () => {
			if (!config.signature) {
				alert('Veuillez entrer une signature pour votre création');
				return;
			}
			
			try {
				const btn = document.getElementById('save-config-btn') as HTMLButtonElement;
				if (btn) {
					btn.disabled = true;
					btn.innerHTML = '<span class="loading loading-spinner"></span> Sauvegarde...';
				}
				
				// Préparer les données pour la sauvegarde
				const totalPrice = config.editionPrice + config.materialPrice;
				
				const lunetteData = {
					signature: config.signature,
					size: config.size,
					largeurPont: config.largeurPont,
					largeurVerre: config.largeurVerre,
					hauteurVerre: config.hauteurVerre,
					longueurBranche: config.longueurBranche,
					prix: totalPrice,
					colors: {
						monture: config.colors.monture,
						branches: config.colors.branches,
						verres: config.colors.verres
					}
				};
				
				await saveLunette(lunetteData);
				
				// Afficher un message de succès
				alert('✅ Configuration sauvegardée avec succès !');
				
				if (btn) {
					btn.disabled = false;
					btn.innerHTML = '💾 Sauvegarder ma création';
				}
			} catch (error: any) {
				console.error('Erreur de sauvegarde:', error);
				alert('❌ Erreur lors de la sauvegarde. Veuillez réessayer.');
				
				const btn = document.getElementById('save-config-btn') as HTMLButtonElement;
				if (btn) {
					btn.disabled = false;
					btn.innerHTML = '💾 Sauvegarder ma création';
				}
			}
		});

		// Restart configuration
		document.getElementById('restart-config-btn')?.addEventListener('click', () => {
			if (confirm('Êtes-vous sûr de vouloir réinitialiser votre configuration ?')) {
				location.reload();
			}
		});

		// Add to cart
		document.getElementById('add-to-cart-btn')?.addEventListener('click', () => {
			console.log('Adding to cart:', config);
			alert('Lunettes ajoutées au panier !');
		});

		// Animate config count
		let count = 314;
		setInterval(() => {
			count = Math.floor(Math.random() * 50) + 300;
			const countEl = document.getElementById('config-count');
			if (countEl) countEl.textContent = count.toString();
		}, 5000);

		// Protection de la page - Vérifier l'authentification
		import { isAuthenticated, pb } from '../JS/pocketbase.js';

		const authModal = document.getElementById('auth-modal') as HTMLDialogElement;
		const configuratorContent = document.getElementById('configurator-content');

		// Fonction pour vérifier et afficher le contenu approprié
		function checkAuth() {
			console.log('🔍 Vérification de l\'authentification...');
			console.log('🔍 Auth valid?', pb.authStore.isValid);
			console.log('🔍 User:', pb.authStore.model);
			
			if (!isAuthenticated()) {
				console.log('❌ Non connecté - Affichage du modal');
				// S'assurer que le modal est affiché
				if (authModal) {
					authModal.classList.add('modal-open');
					authModal.style.display = 'flex';
				}
				// S'assurer que le contenu est masqué
				if (configuratorContent) {
					configuratorContent.style.display = 'none';
					configuratorContent.style.visibility = 'hidden';
				}
			} else {
				console.log('✅ Connecté - Affichage du configurateur');
				// Masquer le modal complètement
				if (authModal) {
					authModal.classList.remove('modal-open');
					authModal.style.display = 'none';
				}
				// Afficher le configurateur
				if (configuratorContent) {
					configuratorContent.style.display = 'block';
					configuratorContent.style.visibility = 'visible';
				}
			}
		}

		// Vérifier immédiatement au chargement
		checkAuth();

		// Re-vérifier après un court délai (pour s'assurer que localStorage est chargé)
		setTimeout(checkAuth, 50);

		// Écouter les changements d'authentification
		pb.authStore.onChange(() => {
			console.log('🔄 Changement d\'authentification détecté');
			checkAuth();
		});
	</script>
</Layout>
