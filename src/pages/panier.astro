---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mon panier - TaVue">
	<div class="min-h-screen bg-base-200 py-12">
		<div class="container mx-auto px-4 max-w-7xl">
			<h1 class="text-4xl font-bold text-center mb-12">Mon panier <span id="cart-count-title">(1)</span></h1>
			
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<!-- Liste des articles -->
				<div class="lg:col-span-2">
					<div id="cart-items-container" class="space-y-6">
						<!-- Les articles seront chargés dynamiquement -->
						<div class="flex justify-center items-center py-20">
							<span class="loading loading-spinner loading-lg text-primary"></span>
						</div>
					</div>
					
					<!-- Message panier vide -->
					<div id="empty-cart-message" class="hidden">
						<div class="card bg-base-100 shadow-xl">
							<div class="card-body text-center py-20">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-base-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
								</svg>
								<h2 class="text-2xl font-bold mb-2">Votre panier est vide</h2>
								<p class="text-base-content/70 mb-6">Commencez à créer vos lunettes personnalisées !</p>
								<a href="/configurateur" class="btn btn-primary">Configurer mes lunettes</a>
							</div>
						</div>
					</div>
					
					<!-- Bouton continuer les créations -->
					<div id="continue-shopping" class="hidden">
						<a href="/configurateur" class="btn btn-outline btn-block">
							Continuer mes créations
						</a>
					</div>
				</div>
				
				<!-- Récapitulatif -->
				<div class="lg:col-span-1">
					<div class="card bg-base-100 shadow-xl sticky top-24">
						<div class="card-body">
							<h2 class="card-title text-2xl mb-4">Récapitulatif</h2>
							
							<div class="space-y-3">
								<div class="flex justify-between text-lg">
									<span>Sous-total</span>
									<span id="subtotal" class="font-semibold">0.00 €</span>
								</div>
								<div class="flex justify-between text-base text-base-content/70">
									<span>Livraison</span>
									<span id="shipping">5.90 €</span>
								</div>
								<div class="divider my-2"></div>
								<div class="flex justify-between text-2xl font-bold">
									<span>Total</span>
									<span id="total">0.00 €</span>
								</div>
							</div>
							
							<div class="card-actions justify-stretch mt-6">
								<button id="checkout-btn" class="btn btn-primary btn-block btn-lg" disabled>
									Passer commande
								</button>
							</div>
							
							<div class="mt-6 space-y-2 text-sm text-base-content/70">
								<div class="flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									<span>Paiement sécurisé</span>
								</div>
								<div class="flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									<span>Livraison sous 48h</span>
								</div>
								<div class="flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
									</svg>
									<span>Garantie 2 ans</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		import { getCart, removeFromCart, getLunetteDetails, isAuthenticated } from '../JS/pocketbase.js';

		let cartItems = [];
		const SHIPPING_COST = 5.90;

		// Vérifier l'authentification
		if (!isAuthenticated()) {
			alert('Vous devez être connecté pour voir votre panier');
			window.location.href = '/connexion';
		}

		// Charger le panier
		async function loadCart() {
			try {
				cartItems = await getCart();
				console.log('🛒 Panier chargé:', cartItems);
				console.log('🛒 Nombre d\'articles:', cartItems.length);
				
				if (cartItems.length === 0) {
					showEmptyCart();
					return;
				}
				
				await displayCartItems();
				updateSummary();
				
				// Activer le bouton de commande
				const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;
				if (checkoutBtn) {
					checkoutBtn.disabled = false;
				}
				
				// Afficher le bouton continuer
				const continueBtn = document.getElementById('continue-shopping');
				if (continueBtn) {
					continueBtn.classList.remove('hidden');
				}
				
			} catch (error) {
				console.error('❌ Erreur de chargement du panier:', error);
				alert('Erreur lors du chargement du panier');
			}
		}

		// Afficher le panier vide
		function showEmptyCart() {
			const container = document.getElementById('cart-items-container');
			const emptyMessage = document.getElementById('empty-cart-message');
			const cartCountTitle = document.getElementById('cart-count-title');
			
			if (container) container.classList.add('hidden');
			if (emptyMessage) emptyMessage.classList.remove('hidden');
			if (cartCountTitle) cartCountTitle.textContent = '(0)';
			
			updateSummary();
		}

		// Afficher les articles du panier
		async function displayCartItems() {
			const container = document.getElementById('cart-items-container');
			if (!container) return;
			
			container.innerHTML = '';
			
			console.log('🎨 Affichage de', cartItems.length, 'articles');
			
			for (const item of cartItems) {
				console.log('📦 Item du panier:', item);
				
				// Récupérer l'ID de la lunette de différentes manières
				let lunetteId = item.id_lunette || item.expand?.id_lunette?.id || null;
				console.log('🔍 ID Lunette trouvé:', lunetteId);
				
				if (!lunetteId) {
					console.error('❌ Pas d\'ID lunette pour:', item);
					continue;
				}
				
				try {
					// Récupérer les détails complets avec les matériaux
					const details = await getLunetteDetails(lunetteId);
					console.log('✅ Détails lunette chargés:', details);
					
					const materiauText = (details as any).materiaux?.monture?.libelle || 'Bois noyer';
					const nomModele = (details as any).nom_modele || 'test';
					const prix = (details as any).prix || 449.00;
					const couleurMonture = (details as any).couleur_monture_hex || '#1d1d1b';
					const couleurBranches = (details as any).couleur_branche_hex || '#8B4513';
					const couleurVerres = (details as any).couleur_verre_hex || 'rgba(135, 206, 235, 0.5)';
					
					const card = document.createElement('div');
					card.className = 'card bg-base-100 shadow-xl';
					card.innerHTML = `
						<div class="card-body">
							<div class="flex flex-col md:flex-row gap-6">
								<!-- Image avec SVG des lunettes -->
								<div class="flex-shrink-0">
									<div class="w-full md:w-48 h-32 bg-white rounded-lg flex items-center justify-center p-2">
										<svg 
											xmlns="http://www.w3.org/2000/svg" 
											xmlns:xlink="http://www.w3.org/1999/xlink" 
											version="1.1" 
											viewBox="50 120 495 140"
											style="filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2)); width: 100%; height: auto;"
										>
											<defs>
												<style>
													.cls-1-cart-${details.id} {
														fill: ${couleurBranches};
													}
													.cls-2-cart-${details.id} {
														isolation: isolate;
													}
													.cls-3-cart-${details.id} {
														fill: ${couleurMonture};
													}
													.cls-4-cart-${details.id} {
														fill: ${couleurBranches};
														stroke: ${couleurMonture};
														stroke-miterlimit: 10;
														stroke-width: 1px;
													}
													.cls-5-cart-${details.id} {
														fill: ${couleurVerres};
														opacity: .75;
													}
													/* Spécifique pour la monture */
													#monture .cls-4-cart-${details.id} {
														fill: ${couleurMonture};
													}
												</style>
											</defs>
											<g class="cls-2-cart-${details.id}">
												<g id="branches">
													<path class="cls-4-cart-${details.id}" d="M108.83,155.14s49.35-5.57,54.93-8.76,11.14-7.96,19.5-9.55,64.48-11.14,64.48-11.14c0,0,7.16-1.99,17.51,5.57s33.04,31.84,39.4,31.05c6.37-.8,9.55-9.55,7.56-13.53s-40.67-32.75-47.36-34.63c-9.53-2.68-21.89-2.39-37.02,0-15.12,2.39-116.22,23.34-116.22,23.34,0,0-13.13,6.12-2.79,17.66Z"/>
													<path class="cls-1-cart-${details.id}" d="M308.24,150.76s-.31,6.15-3.98,5.57c-4.97-.78-35.82-33.83-46.17-32.24,0,0,8.53,2.71,18.46,11.64,6.51,5.86,34.42,37.85,31.69,15.03Z"/>
													<path class="cls-4-cart-${details.id}" d="M374.79,179.65l90.54-29.78s22.13-5.63,25.35-4.02,17.71,30.58,17.71,33.8-2.42,14.01-5.63,14.89c-2.33.64-5.33.11-6.84-4.21-1.41-4.02-6.84-31.73-12.47-31.47s-50.7,15.95-50.7,15.95c0,0-13.28,6.44-18.91,11.27s-32.19,11.27-32.19,11.27c0,0-9.66-7.65-6.84-17.71Z"/>
													<path class="cls-1-cart-${details.id}" d="M381.34,180.1s102.27-35.19,107.85-31.99c0,0-18.2,2.49-41.76,11.88s-66.09,22.03-66.09,22.03v-1.92Z"/>
													<path class="cls-1-cart-${details.id}" d="M485.36,158.06s3.26,0,4.98,3.45,9.77,24.71,9.77,24.71c0,0,.77,4.98,5.17-2.68,0,0-3.07,9.56-5.36,6.79s-9.77-26.33-9.77-26.33c0,0-2.87-6.74-4.79-5.94Z"/>
												</g>
												<g id="monture">
													<path class="cls-4-cart-${details.id}" d="M385.31,180.81c-.24-3.41-9.57-5.22-12.71-6.4-3.14-1.18-15.7,1.96-15.7,1.96-12.17-3.14-54.55-9.03-78.88-9.03s-32.57,11.38-35.32,10.99c-2.75-.39-17.27-.78-23.55-1.96-6.28-1.18-5.1-14.13-39.25-26.48-34.14-12.35-68.29-12.42-68.29-12.42-13.35,4.66-6.76,18.49-6.76,18.49l2.05,6.35c4.32,2.03,3.14,10.52,4.71,23.08s7.46,28.65,14.13,38.46c6.67,9.81,31.79,20.8,44.35,21.19s23.55-1.96,31.79-15.31c8.24-13.34,16.88-36.89,16.88-36.89l10.2,1.57s2.91.31,5.35,3.09,4.43,8.03,7.6,17.31c7.56,22.1,25.12,39.25,25.12,39.25,0,0,5.6,7.43,33.44,12.66,23.08,4.34,42.7-2.46,42.7-2.46,17.72-7.17,21.63-44.96,21.63-44.96,0,0,1.83-13.3,7.81-16.65,7.37-4.14,8.27-4.44,12.71-5.32,3.61-.71.24-13.13,0-16.54ZM190.5,231.32c-9.42,5.1-32.18,7.06-46.31-3.92-14.13-10.99-20.8-30.22-22.76-52.98s7.1-25.23,7.1-25.23c0,0,14.88-.67,34.11,4.03,19.23,4.71,40.42,18.05,40.82,26.69.39,8.63-3.53,46.31-12.95,51.41ZM344.73,255.65c-9.03,4.32-21.47,4.71-31.93,3.92-10.46-.78-37.54-1.57-47.35-31.4,0,0-2.75-14.13-5.1-17.27-2.35-3.14-9.42-14.48-9.42-18.43,0-8.23,7.15-12.97,7.15-12.97,0,0,8.16-5.1,18.75-5.1,10.6,0,64.75,2.75,72.21,12.95,7.46,10.2,7.06,21.98,8.24,31.4,1.18,9.42-3.53,32.57-12.56,36.89Z"/>
												</g>
												<g id="verres">
													<path class="cls-5-cart-${details.id}" d="M116.32,162.87c-.88,6.05.4,37.41,11.44,55.31s37.04,21.35,41.37,21.31,18.51,1.02,24.47-9.27c4.97-8.59,13.17-43.48,9.12-53.05-6.26-14.82-40.4-24.02-40.4-24.02,0,0-26.85-5.46-33.82-4.46,0,0-9.97-.96-12.17,14.17Z"/>
													<path class="cls-5-cart-${details.id}" d="M247.32,192.54s-1.09-9.55,19.57-16.69c11.76-4.06,60.46,3.23,60.46,3.23,0,0,19.09,4.06,21.71,8.28,2.62,4.22,9.46,17.24,8.29,37.97-1.14,20.21-7.31,26.8-12.61,30.31,0,0-7.1,4.93-21.34,5.93-26.65,1.88-37.01-1.14-46.19-7.73-29.88-21.46-29.88-61.3-29.88-61.3Z"/>
												</g>
											</g>
										</svg>
									</div>
								</div>
								
								<!-- Détails -->
								<div class="flex-grow">
									<h3 class="card-title text-xl mb-1">${nomModele}</h3>
									<p class="text-sm text-base-content/70 mb-2">Création personnalisée</p>
									<p class="text-sm mb-3"><strong>Matériau:</strong> ${materiauText}</p>
									
									<div class="flex flex-wrap gap-2">
										<div class="badge badge-outline gap-2">
											<div class="w-3 h-3 rounded-full border border-base-300" style="background-color: ${couleurMonture}"></div>
											Couleur monture
										</div>
										<div class="badge badge-outline gap-2">
											<div class="w-3 h-3 rounded-full border border-base-300" style="background-color: ${couleurBranches}"></div>
											Couleur branches
										</div>
										<div class="badge badge-outline gap-2">
											<div class="w-3 h-3 rounded-full border border-base-300" style="background-color: ${couleurVerres}"></div>
											Couleur verres
										</div>
									</div>
								</div>
								
								<!-- Prix et actions -->
								<div class="flex flex-col items-end justify-between min-w-[120px]">
									<div class="text-2xl font-bold text-primary">${prix.toFixed(2)} €</div>
									<button 
										class="btn btn-error btn-sm btn-outline"
										onclick="removeItem('${item.id}')"
									>
										Retirer
									</button>
								</div>
							</div>
						</div>
					`;
					
					container.appendChild(card);
					console.log('✅ Carte ajoutée au DOM');
				} catch (error) {
					console.error('❌ Erreur de chargement des détails pour:', lunetteId, error);
					
					// Afficher quand même une carte d'erreur
					const errorCard = document.createElement('div');
					errorCard.className = 'alert alert-error';
					errorCard.innerHTML = `
						<span>Erreur de chargement de l'article (ID: ${lunetteId})</span>
						<button class="btn btn-sm btn-ghost" onclick="removeItem('${item.id}')">Retirer</button>
					`;
					container.appendChild(errorCard);
				}
			}
			
			// Mettre à jour le compteur dans le titre
			const cartCountTitle = document.getElementById('cart-count-title');
			if (cartCountTitle) {
				cartCountTitle.textContent = `(${cartItems.length})`;
			}
		}

		// Mettre à jour le récapitulatif
		async function updateSummary() {
			const subtotalEl = document.getElementById('subtotal');
			const totalEl = document.getElementById('total');
			
			let subtotal = 0;
			
			// Calculer le sous-total en récupérant les prix des lunettes
			for (const item of cartItems) {
				try {
					let lunetteId = null;
					if (item.expand?.id_lunette) {
						lunetteId = item.expand.id_lunette.id;
					} else if (item.id_lunette) {
						lunetteId = item.id_lunette;
					}
					
					if (lunetteId) {
						const details = await getLunetteDetails(lunetteId);
						if ((details as any).prix) {
							subtotal += (details as any).prix;
						}
					}
				} catch (error) {
					console.error('Erreur de calcul prix:', error);
				}
			}
			
			const total = subtotal + (cartItems.length > 0 ? SHIPPING_COST : 0);
			
			if (subtotalEl) subtotalEl.textContent = `${subtotal.toFixed(2)} €`;
			if (totalEl) totalEl.textContent = `${total.toFixed(2)} €`;
		}

		// Retirer un article
		(window as any).removeItem = async function(commandeId: string) {
			if (!confirm('Êtes-vous sûr de vouloir retirer cet article du panier ?')) {
				return;
			}
			
			try {
				await removeFromCart(commandeId);
				await loadCart();
			} catch (error) {
				console.error('❌ Erreur de suppression:', error);
				alert('Erreur lors de la suppression de l\'article');
			}
		};

		// Passer commande
		document.getElementById('checkout-btn')?.addEventListener('click', () => {
			if (cartItems.length === 0) {
				alert('Votre panier est vide');
				return;
			}
			
			alert('🚧 Fonctionnalité de paiement en cours de développement');
			// TODO: Implémenter le processus de paiement
		});

		// Charger le panier au chargement de la page
		loadCart();
	</script>
</Layout>
