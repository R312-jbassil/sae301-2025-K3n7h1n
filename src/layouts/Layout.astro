---
import "../styles/global.css"

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'TaVue - Lunettes personnalisées',
	description = 'Créez vos lunettes parfaites en quelques clics. Personnalisez votre monture, vos couleurs et affirmez votre style unique.'
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
	</head>
	<body data-theme="TaVue">
		<!-- Header / Navigation -->
		<header class="navbar bg-base-100 px-6 py-4 sticky top-0 z-50 shadow-sm">
			<div class="navbar-start">
				<a href="/" class="flex items-center gap-2">
					<img src="/logo-tavue.png" alt="Logo TaVue" class="h-8 w-auto" />
				</a>
			</div>
			<div class="navbar-center hidden lg:flex">
				<ul class="menu menu-horizontal px-1 gap-2">
					<li><a href="/#presentation" class="text-base-content hover:text-primary">Présentation</a></li>
					<li>
						<a href="/configurateur" class="text-base-content hover:text-primary flex items-center gap-2">
							Configurer
							<span id="config-badge" class="badge badge-sm badge-primary hidden">Nouveau</span>
						</a>
					</li>
					<li><a href="/#creations" class="text-base-content hover:text-primary">Tes créations</a></li>
				</ul>
			</div>
			<div class="navbar-end gap-2">
				<!-- User menu (hidden by default, shown when logged in) -->
				<div id="user-menu" class="hidden dropdown dropdown-end">
					<label tabindex="0" class="btn btn-ghost btn-circle avatar">
						<div class="w-10 rounded-full bg-primary text-primary-content flex items-center justify-center">
							<span id="user-initial" class="text-lg font-bold">U</span>
						</div>
					</label>
					<ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
						<li class="menu-title">
							<span id="user-name-display">Utilisateur</span>
						</li>
						<li><a href="/configurateur">Configurer mes lunettes</a></li>
						<li><a href="/#creations">Mes créations</a></li>
						<li><a href="#" id="logout-btn">Déconnexion</a></li>
					</ul>
				</div>

				<!-- Login button (shown when not logged in) -->
				<a href="/connexion" id="login-btn" class="btn btn-ghost text-base-content">Connexion</a>

				<!-- Mobile menu -->
				<div class="dropdown dropdown-end lg:hidden">
					<label tabindex="0" class="btn btn-ghost lg:hidden">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
						</svg>
					</label>
					<ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-1 p-2 shadow bg-base-100 rounded-box w-52">
						<li><a href="/#presentation">Présentation</a></li>
						<li><a href="/configurateur">Configurer</a></li>
						<li><a href="/#creations">Tes créations</a></li>
					</ul>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="footer footer-center bg-base-200 text-base-content p-10">
			<div class="max-w-7xl w-full">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8 w-full text-left mb-8">
					<div>
						<img src="/logo-tavue.png" alt="Logo TaVue" class="h-8 w-auto mb-4" />
						<p class="text-sm text-neutral">
							Créez vos lunettes, affirmez-<br />vous avec style et originalité
						</p>
					</div>
					<div>
						<h4 class="font-semibold mb-4">Navigation</h4>
						<ul class="space-y-2">
							<li><a href="/#presentation" class="link link-hover text-neutral">Présentation</a></li>
							<li><a href="/#gamme" class="link link-hover text-neutral">Ma gamme</a></li>
							<li><a href="/#creations" class="link link-hover text-neutral">Mes créations</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-semibold mb-4">À propos</h4>
						<ul class="space-y-2">
							<li><a href="#" class="link link-hover text-neutral">Notre histoire</a></li>
							<li><a href="#" class="link link-hover text-neutral">Mentions légales</a></li>
							<li><a href="#" class="link link-hover text-neutral">CGV</a></li>
						</ul>
					</div>
					<div>
						<h4 class="font-semibold mb-4">Nous suivre</h4>
						<div class="flex gap-4">
							<a href="#" class="btn btn-ghost btn-circle" aria-label="Facebook">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
								</svg>
							</a>
							<a href="#" class="btn btn-ghost btn-circle" aria-label="Instagram">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
								</svg>
							</a>
							<a href="#" class="btn btn-ghost btn-circle" aria-label="Twitter">
								<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
									<path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
								</svg>
							</a>
						</div>
					</div>
				</div>
				<div class="divider"></div>
				<p class="text-sm text-neutral">
					© 2025 TaVue. Tous droits réservés. | 
					<a href="#" class="link link-hover">Mentions légales</a> | 
					<a href="#" class="link link-hover">Politique de Confidentialité</a> | 
					<a href="#" class="link link-hover">CGV</a>
				</p>
				<p class="text-xs text-neutral mt-2">
					contact@tavue.fr
				</p>
			</div>
		</footer>

		<!-- Scroll to top button -->
		<button 
			id="scrollToTop" 
			class="btn btn-circle btn-primary fixed bottom-8 right-8 opacity-0 pointer-events-none transition-opacity shadow-lg"
			aria-label="Retour en haut"
		>
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
			</svg>
		</button>

		<script>
			import { pb, isAuthenticated, getCurrentUser, logout } from '../JS/pocketbase.js';

			// Vérifier et afficher l'état de connexion
			function updateAuthUI() {
				const userMenu = document.getElementById('user-menu');
				const loginBtn = document.getElementById('login-btn');
				const userNameDisplay = document.getElementById('user-name-display');
				const userInitial = document.getElementById('user-initial');

				if (isAuthenticated()) {
					const user = getCurrentUser();
					if (user && userMenu && loginBtn && userNameDisplay && userInitial) {
						// Afficher le menu utilisateur
						userMenu.classList.remove('hidden');
						loginBtn.classList.add('hidden');

						// Mettre à jour le nom et l'initiale
						userNameDisplay.textContent = user.name || user.email;
						userInitial.textContent = (user.name || user.email || 'U')[0].toUpperCase();
					}
				} else {
					// Afficher le bouton de connexion
					if (userMenu && loginBtn) {
						userMenu.classList.add('hidden');
						loginBtn.classList.remove('hidden');
					}
				}
			}

			// Gérer la déconnexion
			const logoutBtn = document.getElementById('logout-btn');
			logoutBtn?.addEventListener('click', (e) => {
				e.preventDefault();
				logout();
			});

			// Mettre à jour l'UI au chargement
			updateAuthUI();

			// Écouter les changements d'authentification
			pb.authStore.onChange(() => {
				updateAuthUI();
			});

			// Smooth scroll for navigation links
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
					e.preventDefault();
					const target = document.querySelector(this.getAttribute('href') || '');
					if (target) {
						target.scrollIntoView({
							behavior: 'smooth',
							block: 'start'
						});
					}
				});
			});

			// Scroll to top button
			const scrollToTopBtn = document.getElementById('scrollToTop');
			
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					scrollToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
				} else {
					scrollToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
				}
			});

			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});

			// Add animation on scroll
			const observerOptions = {
				threshold: 0.1,
				rootMargin: '0px 0px -50px 0px'
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('animate-fade-in');
						observer.unobserve(entry.target);
					}
				});
			}, observerOptions);

			document.querySelectorAll('.card, .hero').forEach((el) => {
				observer.observe(el);
			});
		</script>

		<style>
			@keyframes fade-in {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.animate-fade-in {
				animation: fade-in 0.6s ease-out forwards;
			}

			html {
				scroll-behavior: smooth;
			}
		</style>
	</body>
</html>
